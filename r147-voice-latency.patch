+  for(const stamp of [0,-1,NaN,Infinity,'1793354400000',now+1,sent+0.25])assert.equal(check([job()],path,stamp).confirmed,false,String(stamp));
+  for(const stamp of [0,-1,NaN,Infinity,'1793355000000',sent-1])assert.equal(check([job()],path,sent,stamp).confirmed,false,String(stamp));
+});
+test('exact relative paths cannot degrade into equal basename or suffix',()=>{
+  for(const filename of ['другие/держатель.gcode','держатель.gcode','старое/'+path,'/gcodes/'+path,'C:/gcodes/'+path,'../'+path,'детали/../'+path,'детали//держатель.gcode'])assert.equal(check([job({filename})]).confirmed,false,filename);
