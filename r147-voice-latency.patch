+import { useEffect, useRef } from 'react';
+import type { PrinterModel } from '../types';
+import { PrintNearEndTracker } from './printNearEnd';
+import { PRINT_NEAR_END_CHANGED, printNearEndPreferences } from './printNearEndPreferences';
+import { finishDuration } from './printerFinish';
+import { showAppNotification } from './appNotifications';
+import { nativeNotify } from './native';
+import { audit } from './db';
+import { diagnosticWarning } from './diagnosticLog';
+import { trySpeakNeuralAnnouncement } from './neuralSpeech';
+
+const HISTORY_KEY = 'klipper-print-near-end-history-v1';
+function readHistory() { try { return JSON.parse(localStorage.getItem(HISTORY_KEY) || 'null'); } catch { return undefined; } }
+
+/** Runs independently of the assistant panel, with one bounded pending voice notice. */
+export function usePrintNearEndNotifications(printers: PrinterModel[], enabled: boolean) {
+  const tracker = useRef<PrintNearEndTracker>();
+  if (!tracker.current) tracker.current = new PrintNearEndTracker(readHistory());
+  const latest = useRef({ printers, enabled }); latest.current = { printers, enabled };
+  const tick = useRef<() => void>();
+  const saved = useRef(''), speaking = useRef(false), retryAfter = useRef(0);
+  useEffect(() => {
+    let mounted = true;
+    const persist = () => {
+      const snapshot = tracker.current!.snapshot();
+      // Elapsed time changes every telemetry tick. Persist only job boundaries
+      // and notification flags, keeping a checkpoint when it actually matters.
+      const identity = JSON.stringify(snapshot.jobs.map(job => [job.printerId, job.key, job.active, job.notified, job.spoken]));
+      if (identity === saved.current) return;
+      try { localStorage.setItem(HISTORY_KEY, JSON.stringify(snapshot)); saved.current = identity; }
+      catch (error) { diagnosticWarning('notifications.near_end_history', error); }
+    };
+    const sample = () => {
+      if (!mounted) return;
+      const now = Date.now(), preferences = printNearEndPreferences();
+      const notices = tracker.current!.observe(latest.current.printers, { ...preferences, enabled: latest.current.enabled && preferences.enabled }, now);
+      for (const notice of notices) {
+        if (notice.notified) continue;
+        const title = `${notice.printerName}: печать скоро завершится`, body = `По текущему темпу осталось около ${finishDuration(notice.remainingSeconds)}.`;
+        showAppNotification(title, body, 'info', { dedupeKey: `near-end:${notice.printerId}:${notice.jobKey}`, expiresAfterMs: 12_000 });
+        void nativeNotify(title, body).catch(error => diagnosticWarning('notifications.near_end_native', error, { printerId: notice.printerId }));
+        void audit('print.near_end', `${notice.printerName} · ${body}`).catch(error => diagnosticWarning('notifications.near_end_audit', error, { printerId: notice.printerId }));
+        tracker.current!.markNotified(notice.printerId, notice.jobKey);
+      }
+      persist();
+      if (speaking.current || now < retryAfter.current) return;
+      const notice = notices[0]; if (!notice) return;
+      speaking.current = true;
+      const stillCurrent = () => {
+        if (!mounted || !latest.current.enabled) return false;
+        const currentPreferences = printNearEndPreferences();
+        return tracker.current!.observe(latest.current.printers, currentPreferences).some(current =>
+          current.printerId === notice.printerId && current.jobKey === notice.jobKey);
+      };
+      const text = `На принтере ${notice.printerName.slice(0, 120)} печать скоро завершится. По текущему темпу осталось около ${finishDuration(notice.remainingSeconds)}.`;
+      void trySpeakNeuralAnnouncement(text, stillCurrent).then(played => {
+        if (played) { tracker.current!.markSpoken(notice.printerId, notice.jobKey); persist(); }
+      }).catch(error => { retryAfter.current = Date.now() + 60_000; diagnosticWarning('notifications.near_end_voice', error, { printerId: notice.printerId }); })
+        .finally(() => { speaking.current = false; });
+    };
+    tick.current = sample; sample();
+    const timer = window.setInterval(sample, 5_000);
+    window.addEventListener(PRINT_NEAR_END_CHANGED, sample); window.addEventListener('storage', sample);
+    return () => { mounted = false; tick.current = undefined; window.clearInterval(timer); window.removeEventListener(PRINT_NEAR_END_CHANGED, sample); window.removeEventListener('storage', sample); };
+  }, []);
+  useEffect(() => { tick.current?.(); }, [printers, enabled]);
+}
