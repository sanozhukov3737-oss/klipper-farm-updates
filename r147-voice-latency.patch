+// Portable tests for the exact frame parser used by the packaged Windows worker.
+// c++ -std=c++17 -Wall -Wextra -Werror scripts/check-whisper-context.cpp -o <temporary-test>
+#include "whisper-context.h"
+#include <cassert>
+#include <functional>
+#include <iostream>
+
+using Bytes = std::vector<unsigned char>;
+static void put_u32(Bytes & bytes, size_t offset, uint32_t value) {
+    for (unsigned index = 0; index < 4; ++index) bytes[offset + index] = (value >> (index * 8)) & 0xffu;
+}
+static Bytes wave(size_t size = farm_speech::min_wave_bytes) {
+    Bytes bytes(size);
+    std::memcpy(bytes.data(), "RIFF", 4); put_u32(bytes, 4, static_cast<uint32_t>(size - 8));
+    std::memcpy(bytes.data() + 8, "WAVEfmt ", 8); put_u32(bytes, 16, 16);
+    bytes[20] = bytes[22] = 1; put_u32(bytes, 24, 16000); put_u32(bytes, 28, 32000);
+    bytes[32] = 2; bytes[34] = 16; std::memcpy(bytes.data() + 36, "data", 4);
+    put_u32(bytes, 40, static_cast<uint32_t>(size - 44)); return bytes;
+}
+static Bytes framed(const std::string & context, const Bytes & audio = wave()) {
+    Bytes result(12 + context.size()); std::memcpy(result.data(), farm_speech::context_magic, 8);
+    put_u32(result, 8, static_cast<uint32_t>(context.size()));
+    std::memcpy(result.data() + 12, context.data(), context.size());
+    result.insert(result.end(), audio.begin(), audio.end()); return result;
+}
+static size_t cases = 0;
+static void rejects(const std::function<void()> & action) {
+    bool rejected = false;
+    try { action(); } catch (const std::runtime_error &) { rejected = true; }
+    assert(rejected); ++cases;
+}
+int main() {
+    const auto legacy = farm_speech::parse_recognition_frame(wave());
+    assert(legacy.context.empty() && legacy.wave_offset == 0); ++cases;
+    const std::string first_name = u8"Держатель телефона 12. K1 Max";
+    const auto first = farm_speech::parse_recognition_frame(framed(first_name));
+    const auto second = farm_speech::parse_recognition_frame(framed(u8"Кронштейн камеры 25. K1C"));
+    const auto third = farm_speech::parse_recognition_frame(wave());
+    assert(first.context == first_name && first.wave_offset == 12 + first_name.size());
+    assert(second.context == u8"Кронштейн камеры 25. K1C" && third.context.empty()); ++cases;
+    assert(farm_speech::parse_recognition_frame(framed("")).context.empty()); ++cases;
+    for (const size_t size : {farm_speech::min_wave_bytes, farm_speech::max_wave_bytes}) {
+        assert(farm_speech::parse_recognition_frame(wave(size)).wave_offset == 0); ++cases;
+    }
+    std::string limit; for (size_t index = 0; index < 512; ++index) limit += u8"я";
+    const auto maximum = framed(limit, wave(farm_speech::max_wave_bytes));
+    assert(maximum.size() == farm_speech::max_request_bytes);
+    assert(farm_speech::parse_recognition_frame(maximum).context == limit); ++cases;
+    rejects([&] { farm_speech::parse_recognition_frame(framed(std::string(513, 'x'))); });
+    rejects([&] { farm_speech::parse_recognition_frame(framed(std::string(1025, 'x'))); });
+    rejects([&] { auto value = maximum; value.push_back(0); farm_speech::parse_recognition_frame(value); });
+    rejects([&] { farm_speech::parse_recognition_frame(Bytes{}); });
+    rejects([&] { farm_speech::parse_recognition_frame(wave(farm_speech::min_wave_bytes - 1)); });
+    rejects([&] { farm_speech::parse_recognition_frame(wave(farm_speech::max_wave_bytes + 1)); });
+    for (const std::string & invalid : {std::string("\xc0\xaf"), std::string("\xed\xa0\x80"),
+            std::string("\xf4\x90\x80\x80"), std::string("\xe2\x82"), std::string("\xe0\x80\xaf"),
+            std::string("\xe2\x28\xa1"), std::string("a\0b", 3), std::string("a\nb"),
+            std::string("a\tb"), std::string(u8"Камера\u202eназад"), std::string(u8"Камера\ufeffназад")}) {
+        rejects([&] { farm_speech::parse_recognition_frame(framed(invalid)); });
+    }
+    for (const size_t index : {0u, 4u, 8u, 16u, 20u, 22u, 24u, 28u, 32u, 34u, 36u, 40u}) {
+        auto audio = wave(); audio[index] ^= 1;
+        rejects([&] { farm_speech::parse_recognition_frame(audio); });
+        rejects([&] { farm_speech::parse_recognition_frame(framed(first_name, audio)); });
+    }
+    rejects([&] { auto value = framed(first_name); value[7] = '2'; farm_speech::parse_recognition_frame(value); });
+    rejects([&] { auto value = framed(first_name); put_u32(value, 8, 1025); farm_speech::parse_recognition_frame(value); });
+    rejects([&] { auto value = framed(first_name); put_u32(value, 8, 0); farm_speech::parse_recognition_frame(value); });
+    std::cout << "Whisper context protocol: " << cases << " cases passed\n";
+}
