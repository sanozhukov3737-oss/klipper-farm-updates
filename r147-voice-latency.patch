index 0000000..07b5666
--- /dev/null
+++ b/r146-voice-quality/check-installed-background-tray.ps1
@@ -0,0 +1,161 @@
+﻿# Windows PowerShell 5.1. Exercise the real Explorer tray; no application RPCs.
+param([string]$Action = '')
+$ErrorActionPreference = 'Stop'
+$ProgressPreference = 'SilentlyContinue'
+$result = [ordered]@{ available = $false; performed = $false }
+$clock = [System.Diagnostics.Stopwatch]::StartNew()
+$budgetMs = 9500
+$script:CursorSaved = $false
+$script:CursorMoved = $false
+$oldDpi = [IntPtr]::Zero
+try {
+    if ($Action -notin @('open', 'quit')) { throw 'invalid-action' }
+    Add-Type -AssemblyName UIAutomationClient, UIAutomationTypes, WindowsBase | Out-Null
+    if (-not ('KFBackgroundTrayNative' -as [type])) { Add-Type -TypeDefinition @'
+using System;
+using System.Runtime.InteropServices;
+public static class KFBackgroundTrayNative {
+    [StructLayout(LayoutKind.Sequential)] public struct Point { public int X; public int Y; }
+    [DllImport("user32.dll", CharSet = CharSet.Unicode)] public static extern IntPtr FindWindow(string className, string windowName);
+    [DllImport("user32.dll")] public static extern uint GetWindowThreadProcessId(IntPtr window, out uint processId);
+    [DllImport("user32.dll")] public static extern bool IsWindowVisible(IntPtr window);
+    [DllImport("user32.dll")] public static extern bool GetCursorPos(out Point point);
+    [DllImport("user32.dll")] public static extern bool SetCursorPos(int x, int y);
+    [DllImport("user32.dll")] public static extern void mouse_event(uint flags, uint x, uint y, uint data, UIntPtr extra);
+    [DllImport("user32.dll")] public static extern IntPtr SetThreadDpiAwarenessContext(IntPtr context);
+}
+'@ | Out-Null
+    }
+    try { $oldDpi = [KFBackgroundTrayNative]::SetThreadDpiAwarenessContext([IntPtr](-4)) } catch { }
+    function Test-TimeRemaining { return $clock.ElapsedMilliseconds -lt $budgetMs }
+    function Wait-NextObservation {
+        $left = $budgetMs - $clock.ElapsedMilliseconds
+        if ($left -gt 0) { Start-Sleep -Milliseconds ([int][Math]::Min(100, $left)) }
+    }
+    function Get-WindowProcessId([IntPtr]$Handle) {
+        [uint32]$owner = 0
+        [void][KFBackgroundTrayNative]::GetWindowThreadProcessId($Handle, [ref]$owner); return [int]$owner
+    }
+    function Test-ProcessName([int]$ProcessId, [string]$Expected) {
+        try { return ([System.Diagnostics.Process]::GetProcessById($ProcessId).ProcessName -eq $Expected) } catch { return $false }
+    }
+    function Test-VisibleElement($Element) {
+        try {
+            if ($Element.Current.IsOffscreen) { return $false }
+            $rect = $Element.Current.BoundingRectangle
+            foreach ($number in @($rect.X, $rect.Y, $rect.Width, $rect.Height)) {
+                if ([double]::IsNaN($number) -or [double]::IsInfinity($number)) { return $false } }
+            return -not $rect.IsEmpty -and $rect.Width -gt 0 -and $rect.Height -gt 0
+        } catch { return $false }
+    }
+    function Find-NamedButton($Root, [string]$Name, [int]$ExplorerId) {
+        try {
+            $condition = [System.Windows.Automation.PropertyCondition]::new([System.Windows.Automation.AutomationElement]::NameProperty, $Name)
+            $nodes = $Root.FindAll([System.Windows.Automation.TreeScope]::Descendants, $condition)
+            foreach ($node in $nodes) {
+                if ($node.Current.ProcessId -eq $ExplorerId -and $node.Current.ControlType -eq [System.Windows.Automation.ControlType]::Button -and (Test-VisibleElement $node)) {
+                    return $node } }
+        } catch { }
+        return $null
+    }
+    function Find-TrayIcon($Tray, [int]$ExplorerId) {
+        $node = Find-NamedButton $Tray 'Klipper Farm' $ExplorerId
+        if ($null -ne $node) { return $node }
+        try {
+            # Observed Explorer overflow hosts only; never unrelated app buttons.
+            $condition = [System.Windows.Automation.PropertyCondition]::new([System.Windows.Automation.AutomationElement]::ProcessIdProperty, $ExplorerId)
+            $windows = [System.Windows.Automation.AutomationElement]::RootElement.FindAll([System.Windows.Automation.TreeScope]::Children, $condition)
+            foreach ($window in $windows) {
+                if ($window.Current.ClassName -notin @('NotifyIconOverflowWindow', 'TopLevelWindowForOverflowXamlIsland', 'XamlExplorerHostIslandWindow')) { continue }
+                $node = Find-NamedButton $window 'Klipper Farm' $ExplorerId
+                if ($null -ne $node) { return $node } }
+        } catch { }
+        return $null
+    }
+    function Invoke-ObservedMouseClick($Element, [bool]$RightButton) {
+        if (-not (Test-TimeRemaining)) { throw 'action-deadline-exceeded' }
+        if (-not (Test-VisibleElement $Element)) { throw 'observed-element-unavailable' }
+        $rect = $Element.Current.BoundingRectangle
+        $x = [int][Math]::Floor($rect.Left + $rect.Width / 2)
+        $y = [int][Math]::Floor($rect.Top + $rect.Height / 2)
+        if (-not $script:CursorSaved) {
+            $point = [KFBackgroundTrayNative+Point]::new()
+            if (-not [KFBackgroundTrayNative]::GetCursorPos([ref]$point)) { throw 'cursor-position-unavailable' }
+            $script:OriginalCursor = $point; $script:CursorSaved = $true
+        }
+        if (-not [KFBackgroundTrayNative]::SetCursorPos($x, $y)) { throw 'cursor-move-failed' }
+        $script:CursorMoved = $true
+        [uint32]$down = 2; [uint32]$up = 4
+        if ($RightButton) { $down = 8; $up = 16 }
+        [KFBackgroundTrayNative]::mouse_event($down, 0, 0, 0, [UIntPtr]::Zero)
+        try { Start-Sleep -Milliseconds 35 }
+        finally { [KFBackgroundTrayNative]::mouse_event($up, 0, 0, 0, [UIntPtr]::Zero) }
+    }
+    function Open-Overflow($Tray, [int]$ExplorerId) {
+        $chevron = $null
+        try {
+            $condition = [System.Windows.Automation.PropertyCondition]::new([System.Windows.Automation.AutomationElement]::AutomationIdProperty, 'NotificationChevron')
+            $candidate = $Tray.FindFirst([System.Windows.Automation.TreeScope]::Descendants, $condition)
+            if ($null -ne $candidate -and $candidate.Current.ProcessId -eq $ExplorerId -and (Test-VisibleElement $candidate)) { $chevron = $candidate }
+        } catch { }
+        if ($null -eq $chevron) {
+            foreach ($name in @('Show hidden icons', 'Показать скрытые значки')) {
+                $chevron = Find-NamedButton $Tray $name $ExplorerId
+                if ($null -ne $chevron) { break } }
+        }
+        if ($null -ne $chevron) { Invoke-ObservedMouseClick $chevron $false }
+    }
+    function Find-QuitMenuItem {
+        $handle = [KFBackgroundTrayNative]::FindWindow('#32768', $null)
+        if ($handle -eq [IntPtr]::Zero) { return $null }
+        $owner = Get-WindowProcessId $handle
+        if (-not (Test-ProcessName $owner 'klipper-farm-client')) { return $null }
+        try {
+            $menu = [System.Windows.Automation.AutomationElement]::FromHandle($handle)
+            $condition = [System.Windows.Automation.PropertyCondition]::new([System.Windows.Automation.AutomationElement]::NameProperty, 'Выйти из Klipper Farm')
+            $items = $menu.FindAll([System.Windows.Automation.TreeScope]::Descendants, $condition)
+            foreach ($item in $items) {
+                if ($item.Current.ControlType -eq [System.Windows.Automation.ControlType]::MenuItem -and (Test-VisibleElement $item)) {
+                    return [pscustomobject]@{ Element = $item; OwnerId = $owner } } }
+        } catch { }
+        return $null
+    }
+    $trayHandle = [KFBackgroundTrayNative]::FindWindow('Shell_TrayWnd', $null)
+    if ($trayHandle -eq [IntPtr]::Zero) { throw 'explorer-tray-unavailable' }
+    $explorerId = Get-WindowProcessId $trayHandle
+    if (-not (Test-ProcessName $explorerId 'explorer')) { throw 'explorer-tray-unavailable' }
+    $tray = [System.Windows.Automation.AutomationElement]::FromHandle($trayHandle)
+    $icon = $null; $overflowAttempted = $false
+    while (Test-TimeRemaining) {
+        $icon = Find-TrayIcon $tray $explorerId
+        if ($null -ne $icon) { break }
+        if (-not $overflowAttempted) { $overflowAttempted = $true; Open-Overflow $tray $explorerId }
+        Wait-NextObservation }
+    if ($null -eq $icon) { throw 'tray-icon-not-found' }
+    $result.available = $true
+    Invoke-ObservedMouseClick $icon ($Action -eq 'quit')
+    if ($Action -eq 'open') { $result.performed = $true } else {
+        $quit = $null
+        while (Test-TimeRemaining) {
+            $quit = Find-QuitMenuItem
+            if ($null -ne $quit) { break }
+            Wait-NextObservation }
+        if ($null -eq $quit) { throw 'quit-menu-item-not-found' }
+        $invoke = $null
+        if (-not $quit.Element.TryGetCurrentPattern([System.Windows.Automation.InvokePattern]::Pattern, [ref]$invoke)) { throw 'quit-invoke-pattern-unavailable' }
+        try { ([System.Windows.Automation.InvokePattern]$invoke).Invoke() }
+        catch { if (Test-ProcessName $quit.OwnerId 'klipper-farm-client') { throw } }
+        $result.performed = $true
+    }
+} catch {
+    $reason = [string]$_.Exception.Message
+    if ($reason -notmatch '^[a-z][a-z0-9-]{0,79}$') { $reason = 'tray-ui-automation-failed' }
+    $result.reason = $reason
+} finally {
+    if ($script:CursorSaved -and $script:CursorMoved) {
+        try { [void][KFBackgroundTrayNative]::SetCursorPos($script:OriginalCursor.X, $script:OriginalCursor.Y) } catch { } }
+    if ($oldDpi -ne [IntPtr]::Zero) {
+        try { [void][KFBackgroundTrayNative]::SetThreadDpiAwarenessContext($oldDpi) } catch { } }
+}
+try { [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false) } catch { }
+$result | ConvertTo-Json -Compress
