diff --git a/r146-voice-quality/changes/scripts/check-print-near-end.mjs b/r146-voice-quality/changes/scripts/check-print-near-end.mjs
new file mode 100644
index 0000000..afd3fc4
--- /dev/null
+++ b/r146-voice-quality/changes/scripts/check-print-near-end.mjs
@@ -0,0 +1,117 @@
+import assert from 'node:assert/strict';
+import { build } from 'esbuild';
+const bundle = await build({ stdin: { contents: "export * from './src/lib/printNearEnd';", resolveDir: process.cwd(), loader: 'ts' }, bundle: true, write: false, format: 'esm', platform: 'node' });
+const { PrintNearEndTracker, normalizePrintNearEndPreferences } = await import('data:text/javascript;base64,' + Buffer.from(bundle.outputFiles[0].text).toString('base64'));
+const start = 1_790_000_000_000, preferences = { enabled: true, leadMinutes: 10 }, cases = [];
+let sequence = 0;
+const create = snapshot => new PrintNearEndTracker(snapshot, () => `job-${++sequence}`);
+const printer = (now, patch = {}, id = 'one') => ({ id, name: id === 'one' ? 'K1 Max' : 'K1C', status: { state: 'printing', connectionState: 'online', filename: 'test-cube.gcode', printDuration: 3600, progress: .9, jobUpdatedAt: now, ...patch } });
+const sample = (tracker, now, patch = {}, settings = preferences) => tracker.observe([printer(now, patch)], settings, now);
+const stable = (tracker, now = start) => { assert.equal(sample(tracker, now).length, 0); return sample(tracker, now + 6_000, { printDuration: 3606, progress: .901 })[0]; };
+const test = (name, fn) => { fn(); cases.push({ name, passed: true }); console.log('PASS', name); };
+test('default preferences and corrupt settings are bounded', () => {
+  assert.deepEqual(normalizePrintNearEndPreferences(null), preferences);
+  assert.deepEqual(normalizePrintNearEndPreferences({ enabled: false, leadMinutes: 30 }), { enabled: false, leadMinutes: 30 });
+  for (const leadMinutes of [-1, 0, 1, NaN, Infinity, '10', 500]) assert.equal(normalizePrintNearEndPreferences({ leadMinutes }).leadMinutes, 10);
+});
+test('two distinct live samples confirm approaching the threshold', () => {
+  const tracker = create(), notice = stable(tracker);
+  assert.equal(notice.printerName, 'K1 Max'); assert(notice.remainingSeconds > 300 && notice.remainingSeconds < 600);
+  assert.equal(notice.notified, false); assert.equal(tracker.isPending('one', notice.jobKey, start + 6_000), true);
+});
+test('reprocessing a sample or only updating its timestamp cannot confirm ETA', () => {
+  const tracker = create(); sample(tracker, start);
+  assert.equal(tracker.observe([printer(start)], preferences, start + 6_000).length, 0);
+  assert.equal(sample(tracker, start + 7_000).length, 0);
+});
+test('notification and speech are separate once-per-job flags', () => {
+  const tracker = create(), first = stable(tracker); tracker.markNotified('one', first.jobKey);
+  const pending = sample(tracker, start + 12_000, { printDuration: 3612, progress: .902 })[0];
+  assert.equal(pending.notified, true); tracker.markSpoken('one', first.jobKey);
+  assert.equal(sample(tracker, start + 18_000, { printDuration: 3618, progress: .903 }).length, 0);
+});
+test('the announced flag survives pause, reconnect and ETA revision', () => {
+  const tracker = create(), first = stable(tracker); tracker.markNotified('one', first.jobKey); tracker.markSpoken('one', first.jobKey);
+  for (const patch of [{ state: 'paused' }, { state: 'offline', connectionState: 'offline', filename: undefined }, { progress: .6 }]) sample(tracker, start + 20_000, patch);
+  sample(tracker, start + 30_000, { printDuration: 3630, progress: .91 });
+  assert.equal(sample(tracker, start + 36_000, { printDuration: 3636, progress: .911 }).length, 0);
+});
+test('a transient ready snapshot with retained progress cannot rearm an announced job', () => {
+  const tracker = create(), first = stable(tracker); tracker.markNotified('one', first.jobKey); tracker.markSpoken('one', first.jobKey);
+  sample(tracker, start + 12_000, { state: 'ready', printDuration: 3612, progress: .902 });
+  sample(tracker, start + 18_000, { printDuration: 3618, progress: .903 });
+  assert.equal(sample(tracker, start + 24_000, { printDuration: 3624, progress: .904 }).length, 0);
+  assert.equal(tracker.snapshot().jobs[0].key, first.jobKey);
+});
+test('timestamp-only updates cannot indefinitely renew a pending forecast', () => {
+  const tracker = create(), first = stable(tracker);
+  for (const offset of [12_000, 18_000, 24_000]) sample(tracker, start + offset, { printDuration: 3606, progress: .901 });
+  assert.equal(sample(tracker, start + 30_000, { printDuration: 3606, progress: .901 }).length, 0);
+  assert.equal(tracker.isPending('one', first.jobKey, start + 30_000), false);
+});
+test('pause, completion, stale telemetry and cancellation expire pending speech', () => {
+  for (const patch of [{ state: 'paused' }, { state: 'ready', printStatsState: 'complete' }, { state: 'ready', printStatsState: 'cancelled' }, { state: 'error' }, { state: 'offline', connectionState: 'offline' }, { connectionState: 'degraded' }, { remoteControlSuspended: true }, { jobUpdatedAt: start - 30_000 }]) {
+    const tracker = create(), first = stable(tracker); sample(tracker, start + 12_000, patch);
+    assert.equal(tracker.isPending('one', first.jobKey, start + 12_000), false, JSON.stringify(patch));
+  }
+});
+test('unavailable or unstable forecasts do not announce', () => {
+  for (const patch of [{ jobUpdatedAt: undefined }, { progress: 0 }, { progress: 1 }, { printDuration: NaN }, { printDuration: 45, progress: .9 }, { printDuration: 180, progress: .4 }]) {
+    const tracker = create(); sample(tracker, start, patch);
+    assert.equal(sample(tracker, start + 6_000, patch).length, 0, JSON.stringify(patch));
+  }
+});
+test('unknown ETA remains silent until a usable forecast exists', () => {
+  const tracker = create(); sample(tracker, start, { progress: 0, printDuration: 30 });
+  assert.equal(sample(tracker, start + 6_000, { printDuration: 3600, progress: .9 }).length, 0);
+  assert.equal(sample(tracker, start + 12_000, { printDuration: 3606, progress: .901 }).length, 1);
+});
+test('ETA rising above the threshold suspends an unspoken notice', () => {
+  const tracker = create(), first = stable(tracker); tracker.markNotified('one', first.jobKey);
+  sample(tracker, start + 12_000, { progress: .6, printDuration: 3612 });
+  assert.equal(tracker.isPending('one', first.jobKey, start + 12_000), false);
+  assert.equal(sample(tracker, start + 18_000, { progress: .91, printDuration: 3618 }).length, 0);
+  const next = sample(tracker, start + 24_000, { progress: .911, printDuration: 3624 })[0];
+  assert.equal(next.jobKey, first.jobKey); assert.equal(next.notified, true);
+});
+test('a changed file or elapsed/progress reset starts a new observed job', () => {
+  for (const patch of [{ filename: 'second-cube.gcode', printDuration: 300, progress: .8 }, { printDuration: 300, progress: .8 }]) {
+    const tracker = create(), first = stable(tracker); tracker.markSpoken('one', first.jobKey);
+    assert.equal(sample(tracker, start + 12_000, patch).length, 0);
+    const next = sample(tracker, start + 18_000, { ...patch, printDuration: 306, progress: .81 })[0];
+    assert(next); assert.notEqual(next.jobKey, first.jobKey);
+  }
+});
+test('a terminal boundary permits reprinting the same file', () => {
+  const tracker = create(), first = stable(tracker); tracker.markSpoken('one', first.jobKey);
+  sample(tracker, start + 12_000, { state: 'ready', progress: 1 });
+  sample(tracker, start + 18_000);
+  const next = sample(tracker, start + 24_000, { printDuration: 3606, progress: .901 })[0];
+  assert(next); assert.notEqual(next.jobKey, first.jobKey);
+});
+test('restart restores already announced jobs without replaying the message', () => {
+  const tracker = create(), first = stable(tracker); tracker.markNotified('one', first.jobKey); tracker.markSpoken('one', first.jobKey);
+  const restored = create(JSON.parse(JSON.stringify(tracker.snapshot())));
+  sample(restored, start + 30_000, { printDuration: 3630, progress: .91 });
+  assert.equal(sample(restored, start + 36_000, { printDuration: 3636, progress: .911 }).length, 0);
+});
+test('disabled settings and a shorter lead time do not generate notices', () => {
+  for (const settings of [{ enabled: false, leadMinutes: 10 }, { enabled: true, leadMinutes: 5 }]) {
+    const tracker = create(); sample(tracker, start, {}, settings);
