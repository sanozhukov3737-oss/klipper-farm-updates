diff --git a/r146-voice-quality/changes/src/lib/gcodeAnalysis.ts b/r146-voice-quality/changes/src/lib/gcodeAnalysis.ts
new file mode 100644
index 0000000..b687ad9
--- /dev/null
+++ b/r146-voice-quality/changes/src/lib/gcodeAnalysis.ts
@@ -0,0 +1,273 @@
+export type GCodeTextAnalysis={
+  bounds:{x:number;y:number;z:number};
+  minX:number;
+  maxX:number;
+  minY:number;
+  maxY:number;
+  maxHotend:number;
+  maxBed:number;
+  dangerousCommand?:string;
+  hasCrealityMacro:boolean;
+  hasForgeStart:boolean;
+  forgeStartHasParameters:boolean;
+  hasForgeEnd:boolean;
+  hasStopMod:boolean;
+  lineCount:number;
+  metadata:{
+    filamentType?:string;
+    /** Explicit slicer estimate in grams; absent when missing or ambiguous. */
+    filamentWeightGrams?:number;
+    nozzleDiameter?:number;
+    layerHeight?:number;
+    estimatedTime?:number;
+    slicer?:string;
+    printerModel?:string;
+  };
+};
+
+type Range={seen:boolean;min:number;max:number};
+
+export const MAX_SCANNED_GCODE_LINE_LENGTH=32*1024;
+
+const numeric='([-+]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][-+]?\\d+)?)';
+const axisPatterns={
+  x:new RegExp(`X\\s*${numeric}`,'i'),
+  y:new RegExp(`Y\\s*${numeric}`,'i'),
+  z:new RegExp(`Z\\s*${numeric}`,'i')
+};
+const hotendPattern=new RegExp(`^M10[49](?:\\s|$).*?S\\s*${numeric}`,'i');
+const bedPattern=new RegExp(`^M1(?:40|90)(?:\\s|$).*?S\\s*${numeric}`,'i');
+const dangerousPattern=/^(?:M112|FIRMWARE_RESTART|RESTART|SAVE_CONFIG|RUN_SHELL_COMMAND|UPDATE_DELAYED_GCODE)(?:\s|\*|$)/i;
+
+const emptyRange=():Range=>({seen:false,min:0,max:0});
+const updateRange=(range:Range,value:number)=>{
+  if(!Number.isFinite(value))return;
+  if(!range.seen){range.seen=true;range.min=value;range.max=value;return}
+  if(value<range.min)range.min=value;
+  if(value>range.max)range.max=value;
+};
+const matchedNumber=(line:string,pattern:RegExp)=>{
+  const match=line.match(pattern),value=match?Number(match[1]):Number.NaN;
+  return Number.isFinite(value)?value:undefined;
+};
+const span=(range:Range)=>range.seen?Math.max(0,range.max-range.min):0;
+const boundedValue=(value:string,maximum=80)=>value.trim().replace(/^['"]|['"]$/g,'').slice(0,maximum);
+const firstFinite=(value:string,maximum:number)=>{
+  const match=value.match(/[-+]?(?:\d+(?:\.\d*)?|\.\d+)/),number=match?Number(match[0]):Number.NaN;
+  return Number.isFinite(number)&&number>=0&&number<=maximum?number:undefined;
+};
+const durationSeconds=(value:string)=>{
+  const plain=Number(value.trim());
+  if(Number.isFinite(plain)&&plain>0&&plain<366*24*3600)return plain;
+  let total=0,matched=false;
+  for(const token of value.matchAll(/(\d+(?:\.\d+)?)\s*(d|h|m|s)/gi)){
+    const amount=Number(token[1]),unit=token[2].toLowerCase();
+    if(!Number.isFinite(amount))continue;
+    matched=true;
+    total+=amount*(unit==='d'?86400:unit==='h'?3600:unit==='m'?60:1);
+  }
+  return matched&&total>0&&total<366*24*3600?total:undefined;
+};
+const parseMetadataComment=(comment:string,metadata:GCodeTextAnalysis['metadata'])=>{
+  if(!comment)return;
+  if(!metadata.slicer){
+    const generated=comment.match(/generated (?:by|with)\s+(.{1,70})/i);
+    if(generated)metadata.slicer=boundedValue(generated[1]);
+    else if(/OrcaSlicer/i.test(comment))metadata.slicer='OrcaSlicer';
+    else if(/PrusaSlicer/i.test(comment))metadata.slicer='PrusaSlicer';
+    else if(/Cura_SteamEngine|Ultimaker Cura/i.test(comment))metadata.slicer='Cura';
+    else if(/Simplify3D/i.test(comment))metadata.slicer='Simplify3D';
+  }
+  const pair=comment.match(/^([^:=]{1,80})\s*(?:=|:)\s*(.+)$/);
+  if(!pair)return;
+  const key=pair[1].toLowerCase().trim().replace(/[\s_-]+/g,' '),value=pair[2].trim();
+  if(!metadata.filamentType&&/^(?:filament type|material)$/.test(key)){
+    const material=boundedValue(value.split(/[;,]/)[0],32).toUpperCase();
+    if(/^[A-Z0-9+_. -]{1,32}$/.test(material))metadata.filamentType=material;
+  }else if(metadata.nozzleDiameter===undefined&&/(?:nozzle diameter|nozzle size|extruder diameter)/.test(key)){
+    metadata.nozzleDiameter=firstFinite(value,5);
+  }else if(metadata.layerHeight===undefined&&/^layer height$/.test(key)){
+    metadata.layerHeight=firstFinite(value,10);
+  }else if(metadata.estimatedTime===undefined&&/(?:estimated printing time|model printing time|^time$)/.test(key)){
+    metadata.estimatedTime=durationSeconds(value);
+  }else if(!metadata.printerModel&&/(?:printer model|machine name|printer settings id)/.test(key)){
+    metadata.printerModel=boundedValue(value,120);
+  }
+};
+
+// Mass cannot be inferred from a filename or extrusion alone. Accept one
+// explicit scalar estimate only; lists can describe different materials/tools.
+const filamentWeightComment=(comment:string):number|null|undefined=>{
+  const pair=comment.match(/^([^:=]{1,80})\s*(?:=|:)\s*(.*)$/);
+  if(!pair)return;
+  const key=pair[1].toLowerCase().trim().replace(/[\s_-]+/g,' ');
+  if(!/^(?:(?:total )?filament (?:used|weight)|filament weight total) \[g\]$/.test(key))return;
+  const value=pair[2].trim();
+  if(!/^(?:\d+(?:\.\d+)?|\.\d+)$/.test(value))return null;
+  const grams=Number(value);
+  return Number.isFinite(grams)&&grams>0&&grams<=1_000_000?grams:null;
+};
+
+class GCodeAccumulator{
+  private x=emptyRange();
+  private y=emptyRange();
+  private z=emptyRange();
+  private absolute=true;
+  private maxHotend=0;
+  private maxBed=0;
+  private dangerousCommand?:string;
+  private hasCrealityMacro=false;
+  private hasForgeStart=false;
+  private forgeStartHasParameters=false;
+  private hasForgeEnd=false;
+  private hasStopMod=false;
+  private lineCount=0;
+  private metadata:GCodeTextAnalysis['metadata']={};
+  private filamentWeight?:number;
+  private filamentWeightAmbiguous=false;
+
+  push(rawLine:string){
+    const raw=rawLine.slice(0,MAX_SCANNED_GCODE_LINE_LENGTH);
+    const comment=raw.indexOf(';');
+    parseMetadataComment(comment>=0?raw.slice(comment+1).trim():'',this.metadata);
+    // Slicer metadata is a standalone comment, not a motion's inline annotation.
+    if(comment>=0&&!raw.slice(0,comment).trim()){
+      const weight=filamentWeightComment(raw.slice(comment+1).trim());
+      if(weight!==undefined){
+        if(rawLine.length>=MAX_SCANNED_GCODE_LINE_LENGTH||weight===null||this.filamentWeight!==undefined&&this.filamentWeight!==weight)this.filamentWeightAmbiguous=true;
+        else this.filamentWeight=weight;
+      }
+    }
+    const line=(comment>=0?raw.slice(0,comment):raw).trim().replace(/^N\d+\s+/i,'');
+    this.lineCount++;
+
+    if(/^G90(?:\s|$)/i.test(line))this.absolute=true;
+    else if(/^G91(?:\s|$)/i.test(line))this.absolute=false;
+
+    if(this.absolute&&/^G0?[01](?=\s|[XYZ]|$)/i.test(line)){
+      const xValue=matchedNumber(line,axisPatterns.x),yValue=matchedNumber(line,axisPatterns.y),zValue=matchedNumber(line,axisPatterns.z);
+      if(xValue!==undefined)updateRange(this.x,xValue);
+      if(yValue!==undefined)updateRange(this.y,yValue);
+      if(zValue!==undefined)updateRange(this.z,zValue);
+    }
+
+    const hotend=matchedNumber(line,hotendPattern),bed=matchedNumber(line,bedPattern);
+    if(hotend!==undefined&&hotend>this.maxHotend)this.maxHotend=hotend;
+    if(bed!==undefined&&bed>this.maxBed)this.maxBed=bed;
+    if(!this.dangerousCommand&&dangerousPattern.test(line))this.dangerousCommand=line.slice(0,80);
+    if(!this.hasCrealityMacro&&/\bCX_[A-Z0-9_]+/i.test(line))this.hasCrealityMacro=true;
+    if(/^START_PRINT(?:\s|$)/i.test(line)){
+      this.hasForgeStart=true;
+      if(/\bEXTRUDER_TEMP\s*=\s*\S+/i.test(line)&&/\bBED_TEMP\s*=\s*\S+/i.test(line))this.forgeStartHasParameters=true;
+    }
+    if(/^END_PRINT(?:\s|$)/i.test(line))this.hasForgeEnd=true;
+    if(/^STOP_MOD(?:\s|$)/i.test(line))this.hasStopMod=true;
+  }
+
+  finish():GCodeTextAnalysis{
+    return {
+      bounds:{x:span(this.x),y:span(this.y),z:this.z.seen?Math.max(0,this.z.max):0},
+      minX:this.x.seen?Math.min(0,this.x.min):0,
+      maxX:this.x.seen?Math.max(0,this.x.max):0,
+      minY:this.y.seen?Math.min(0,this.y.min):0,
+      maxY:this.y.seen?Math.max(0,this.y.max):0,
+      maxHotend:this.maxHotend,
+      maxBed:this.maxBed,
+      dangerousCommand:this.dangerousCommand,
+      hasCrealityMacro:this.hasCrealityMacro,
+      hasForgeStart:this.hasForgeStart,
+      forgeStartHasParameters:this.forgeStartHasParameters,
+      hasForgeEnd:this.hasForgeEnd,
+      hasStopMod:this.hasStopMod,
+      lineCount:this.lineCount,
+      metadata:{...this.metadata,...(!this.filamentWeightAmbiguous&&this.filamentWeight!==undefined?{filamentWeightGrams:this.filamentWeight}:{})}
+    };
+  }
+}
+
+/**
+ * Scans G-code in one pass without collecting every coordinate in arrays.
+ * Large production files can contain hundreds of thousands of moves; spreading
+ * those arrays into Math.min/Math.max exceeds the WebView JavaScript call stack.
+ */
+export function analyzeGCodeText(text:string):GCodeTextAnalysis{
+  const scanner=new GCodeAccumulator();
+  let offset=0;
+  while(offset<text.length){
+    const newline=text.indexOf('\n',offset),end=newline<0?text.length:newline;
+    scanner.push(text.slice(offset,end));
+    if(newline<0)break;
+    offset=newline+1;
+  }
+  return scanner.finish();
+}
+
+const throwIfCancelled=(signal?:AbortSignal)=>{
+  if(signal?.aborted){const error=new Error('Анализ G-code отменён');error.name='AbortError';throw error}
+};
+
+/** Cooperative WebView parser used by previews and remote-file validation. */
+export async function analyzeGCodeTextAsync(text:string,signal?:AbortSignal,yieldEvery=2_048):Promise<GCodeTextAnalysis>{
+  const scanner=new GCodeAccumulator();
+  let offset=0,lines=0;
+  while(offset<text.length){
+    throwIfCancelled(signal);
+    const newline=text.indexOf('\n',offset),end=newline<0?text.length:newline;
+    scanner.push(text.slice(offset,end));
+    if(newline<0)break;
+    offset=newline+1;
+    if(++lines%Math.max(128,yieldEvery)===0)await new Promise<void>(resolve=>setTimeout(resolve,0));
+  }
+  throwIfCancelled(signal);
+  return scanner.finish();
+}
+
+/**
+ * Reads a browser File/Blob incrementally. Only one bounded line and one binary
+ * chunk are resident in JavaScript, so a 100 MiB production file does not turn
+ * into an ArrayBuffer + number[] + UTF-16 string inside WebView2.
+ */
+export async function analyzeGCodeByteChunks(chunks:AsyncIterable<Uint8Array>,signal?:AbortSignal):Promise<GCodeTextAnalysis>{
+  const scanner=new GCodeAccumulator(),decoder=new TextDecoder();
+  let line='',pendingLine=false;
+  let lines=0,budgetStarted=performance.now();
+  const feed=async(text:string)=>{
+    let offset=0;
+    while(offset<text.length){
+      const newline=text.indexOf('\n',offset),end=newline<0?text.length:newline;
+      if(end>offset)pendingLine=true;
+      if(line.length<MAX_SCANNED_GCODE_LINE_LENGTH){
+        const remaining=MAX_SCANNED_GCODE_LINE_LENGTH-line.length;
+        line+=text.slice(offset,Math.min(end,offset+remaining));
+      }
+      if(newline<0)break;
+      scanner.push(line);
+      line='';
+      pendingLine=false;
+      offset=newline+1;
+      if(++lines%512===0&&performance.now()-budgetStarted>=8){
+        await new Promise<void>(resolve=>setTimeout(resolve,0));throwIfCancelled(signal);budgetStarted=performance.now();
+      }
+    }
+  };
+  for await(const value of chunks){throwIfCancelled(signal);if(value.byteLength)await feed(decoder.decode(value,{stream:true}))}
+  await feed(decoder.decode());
+  throwIfCancelled(signal);
+  if(pendingLine)scanner.push(line);
+  return scanner.finish();
+}
+
+export async function analyzeGCodeFile(file:Blob,signal?:AbortSignal):Promise<GCodeTextAnalysis>{
+  const stream=async function*(){
+    const reader=file.stream().getReader();
+    try{
+      while(true){
+        throwIfCancelled(signal);
+        const {done,value}=await reader.read();
+        if(done)break;
+        if(value?.byteLength)yield value;
+      }
+    }finally{if(signal?.aborted)await reader.cancel().catch(()=>{});reader.releaseLock()}
+  };
+  return analyzeGCodeByteChunks(stream(),signal);
+}
diff --git a/r146-voice-quality/changes/src/lib/gcodeValidation.ts b/r146-voice-quality/changes/src/lib/gcodeValidation.ts
new file mode 100644
index 0000000..cabd859
--- /dev/null
+++ b/r146-voice-quality/changes/src/lib/gcodeValidation.ts
@@ -0,0 +1,132 @@
+import type { GCodeMetadata, PrinterModel } from '../types';
+import type { MoonrakerClient, PrintStartOptions } from './moonraker';
+import { hasUsefulGCodeMetadata, inferPrinterPreset, metadataCompatibility } from './gcodeCompatibility';
+import { analyzeGCodeFile, analyzeGCodeText, analyzeGCodeTextAsync, type GCodeTextAnalysis } from './gcodeAnalysis';
+import { printableArea } from './printerProfile';
+import { modelDependentOperationsBlocked } from './modelSafety';
+
+export const GCODE_VALIDATION_ENGINE_VERSION=6;
+export type ValidationIssue={level:'error'|'warning'|'info';code:string;message:string};
+export type GCodeValidation={ok:boolean;issues:ValidationIssue[];bounds?:{x:number;y:number;z:number};metadata?:GCodeMetadata};
+
+export const printStartOptionsFromValidation=(report:GCodeValidation):PrintStartOptions=>({
+  expectsMoonrakerStop:report.issues.some(issue=>issue.code==='forgex_moonraker_stop'),
+  estimatedDuration:report.metadata?.estimated_time,
+});
+
+const displayBound=(value:number)=>Number.isInteger(value)?String(value):value.toFixed(1);
+
+export function validateGCodeAnalysis(
+  printer:PrinterModel,
+  filename:string,
+  analysis:GCodeTextAnalysis,
+  moonrakerMetadata?:GCodeMetadata,
+  contentAvailable=true,
+):GCodeValidation{
+  const issues:ValidationIssue[]=[];
+  const profile={bedX:220,bedY:220,maxZ:250,nozzle:.4,materials:['PLA','PETG'],...printer.profile};
+  const area=printableArea(profile);
+  const coordinateTolerance=profile.preset==='flashforge-ad5m'?1e-6:2;
+  const bounds={...analysis.bounds,z:Math.max(moonrakerMetadata?.object_height??0,analysis.bounds.z)};
+  const derived:GCodeMetadata={
+    filename,
+    ...(analysis.metadata.estimatedTime?{estimated_time:analysis.metadata.estimatedTime}:{}),
+    ...(analysis.metadata.filamentType?{filament_type:analysis.metadata.filamentType}:{}),
+    ...(analysis.metadata.filamentWeightGrams!==undefined?{filament_weight_total:analysis.metadata.filamentWeightGrams}:{}),
+    ...(analysis.metadata.nozzleDiameter?{nozzle_diameter:analysis.metadata.nozzleDiameter}:{}),
+    ...(analysis.metadata.layerHeight?{layer_height:analysis.metadata.layerHeight}:{}),
+    ...(analysis.metadata.slicer?{slicer:analysis.metadata.slicer}:{}),
+    ...(analysis.metadata.printerModel?{printer_model:analysis.metadata.printerModel}:{}),
+    ...(analysis.bounds.z>0?{object_height:analysis.bounds.z}:{}),
+    ...(analysis.maxHotend>0?{first_layer_extr_temp:analysis.maxHotend}:{}),
+    ...(analysis.maxBed>0?{first_layer_bed_temp:analysis.maxBed}:{}),
+  };
+  const metadata:GCodeMetadata={...derived,...(moonrakerMetadata??{}),filename:moonrakerMetadata?.filename||filename};
+
+  if(modelDependentOperationsBlocked(printer))issues.push({level:'error',code:'model_conflict',message:'Признаки модели противоречат друг другу. Выберите и подтвердите модель вручную в настройках принтера.'});
+
+  if(bounds.x>area.bedX+1)issues.push({level:'error',code:'bed_x',message:`Размер X ${bounds.x.toFixed(1)} мм больше стола ${area.bedX} мм`});
+  if(bounds.y>area.bedY+1)issues.push({level:'error',code:'bed_y',message:`Размер Y ${bounds.y.toFixed(1)} мм больше стола ${area.bedY} мм`});
+  if(bounds.z>profile.maxZ+1)issues.push({level:'error',code:'height',message:`Высота ${bounds.z.toFixed(1)} мм больше лимита ${profile.maxZ} мм`});
+  if(analysis.minX<area.xMin-coordinateTolerance||analysis.maxX>area.xMax+coordinateTolerance){
+    issues.push({level:'error',code:'x_range',message:`Координаты X ${analysis.minX.toFixed(1)}…${analysis.maxX.toFixed(1)} мм выходят за стол ${displayBound(area.xMin)}…${displayBound(area.xMax)} мм`});
+  }
+  if(analysis.minY<area.yMin-coordinateTolerance||analysis.maxY>area.yMax+coordinateTolerance){
+    issues.push({level:'error',code:'y_range',message:`Координаты Y ${analysis.minY.toFixed(1)}…${analysis.maxY.toFixed(1)} мм выходят за стол ${displayBound(area.yMin)}…${displayBound(area.yMax)} мм`});
+  }
+
+  const quick=metadataCompatibility(printer,metadata);
+  if(quick.level==='unknown'){
+    issues.push({
+      level:contentAvailable?'warning':'error',
+      code:'metadata_missing',
