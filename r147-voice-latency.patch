+            _ => Err("Неизвестная модель распознавания".into()),
+        }
+    }
+
+    fn filename(self) -> &'static str {
+        match self {
+            Self::Base => "ggml-base-q5_1.bin",
+            Self::Small => "ggml-small-q5_1.bin",
+        }
+    }
+}
 
