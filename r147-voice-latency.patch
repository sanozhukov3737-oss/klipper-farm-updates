@@ -0,0 +1,13 @@
+import { normalizePrintNearEndPreferences, type PrintNearEndPreferences } from './printNearEnd';
+export const PRINT_NEAR_END_KEY = 'klipper-print-near-end-v1';
+export const PRINT_NEAR_END_CHANGED = 'klipper-print-near-end-changed';
+export function printNearEndPreferences(): PrintNearEndPreferences {
+  try { return normalizePrintNearEndPreferences(JSON.parse(localStorage.getItem(PRINT_NEAR_END_KEY) || 'null')); }
+  catch { return normalizePrintNearEndPreferences(null); }
+}
+export function savePrintNearEndPreferences(value: PrintNearEndPreferences) {
+  const normalized = normalizePrintNearEndPreferences(value);
+  localStorage.setItem(PRINT_NEAR_END_KEY, JSON.stringify(normalized));
+  window.dispatchEvent(new Event(PRINT_NEAR_END_CHANGED));
+  return normalized;
+}
