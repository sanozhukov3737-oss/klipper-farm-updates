@@ -0,0 +1,218 @@
+//! Opt-in desktop lifetime. Hiding keeps the authenticated monitoring WebView
+//! and its notification hooks alive; an explicit application exit still owns
+//! daemon shutdown in lib.rs.
+use super::*;
+use tauri::{menu::{Menu, MenuItem}, tray::{MouseButton, MouseButtonState, TrayIconBuilder, TrayIconEvent}};
+
+const SETTINGS_KEY: &str = "desktop.background";
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+struct Preferences {
+    enabled: bool,
+}
+
+#[derive(Clone, Copy, Debug, Default)]
+struct Lifecycle {
+    enabled: bool,
+    tray_available: bool,
+    quitting: bool,
+}
+
+impl Lifecycle {
+    fn hide_on_close(&self, label: &str) -> bool {
+        label == "main" && self.enabled && self.tray_available && !self.quitting
+    }
+
+    fn change(&mut self, enabled: bool, persist: impl FnOnce() -> Result<(), String>) -> Result<(), String> {
+        if enabled && (!self.tray_available || self.quitting) {
+            return Err("Фоновый режим сейчас недоступен. Перезапустите приложение.".into());
+        }
+        persist()?;
+        self.enabled = enabled;
+        Ok(())
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct BackgroundState(Mutex<Lifecycle>);
+
+#[derive(Clone, Copy, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(crate) struct BackgroundModeStatus {
+    enabled: bool,
+    available: bool,
+}
+
+fn read_preferences(connection: &Connection) -> Result<Preferences, String> {
+    let value: Option<String> = connection.query_row(
+        "SELECT value FROM kv WHERE key=?1", [SETTINGS_KEY], |row| row.get(0),
+    ).optional().map_err(|error| error.to_string())?;
+    // A corrupt/old setting must never unexpectedly keep a closed app alive.
+    Ok(value.filter(|value| value.len() <= 128)
+        .and_then(|value| serde_json::from_str(&value).ok()).unwrap_or_default())
+}
+
+fn write_preferences(connection: &Connection, enabled: bool) -> Result<(), String> {
+    let value = serde_json::to_string(&Preferences { enabled }).map_err(|error| error.to_string())?;
+    connection.execute(
+        "INSERT INTO kv(key,value,updated_at) VALUES(?1,?2,?3) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at",
+        params![SETTINGS_KEY, value, now_ms()],
+    ).map_err(|error| error.to_string())?;
+    Ok(())
+}
+
+pub(crate) fn open_main(app: &AppHandle) {
+    if let Some(window) = app.get_webview_window("main") {
+        if let Err(error) = window.show().and_then(|_| window.unminimize()).and_then(|_| window.set_focus()) {
+            desktop_startup::record("BACKGROUND_OPEN_FAILED", &error.to_string());
+        }
+    }
+}
+
+fn quit(app: &AppHandle) {
+    let background = app.state::<BackgroundState>();
+    if let Ok(mut state) = background.0.lock() {
+        state.quitting = true;
+    }
+    // Do not duplicate shutdown here. The normal ExitRequested/Exit handler
+    // stops only the desktop-owned daemon, including startup/recovery races.
+    app.exit(0);
+}
+
+pub(crate) fn initialize(app: &AppHandle) -> Result<(), String> {
+    let preferences = read_preferences(&open_db(app)?)?;
+    let open = MenuItem::with_id(app, "background-open", "Открыть Klipper Farm", true, None::<&str>)
+        .map_err(|error| error.to_string())?;
+    let quit_item = MenuItem::with_id(app, "background-quit", "Выйти из Klipper Farm", true, None::<&str>)
+        .map_err(|error| error.to_string())?;
+    let menu = Menu::with_items(app, &[&open, &quit_item]).map_err(|error| error.to_string())?;
+    let icon = app.default_window_icon().cloned().ok_or("Нет значка приложения для трея")?;
+    TrayIconBuilder::with_id("klipper-farm-background")
+        .icon(icon)
+        .tooltip("Klipper Farm")
+        .menu(&menu)
+        .show_menu_on_left_click(false)
+        .on_menu_event(|app, event| match event.id().as_ref() {
+            "background-open" => open_main(app),
+            "background-quit" => quit(app),
+            _ => {}
+        })
+        .on_tray_icon_event(|tray, event| {
+            if matches!(event, TrayIconEvent::Click { button: MouseButton::Left, button_state: MouseButtonState::Up, .. }) {
+                open_main(tray.app_handle());
+            }
+        })
+        .build(app).map_err(|error| error.to_string())?;
+    let background = app.state::<BackgroundState>();
+    let mut state = background.0.lock().map_err(|_| "Фоновая настройка занята")?;
+    state.enabled = preferences.enabled;
+    state.tray_available = true;
+    Ok(())
+}
+
+pub(crate) fn on_window_event(window: &tauri::Window, event: &tauri::WindowEvent) {
+    if let tauri::WindowEvent::CloseRequested { api, .. } = event {
+        let hide = window.state::<BackgroundState>().0.lock()
+            .map(|state| state.hide_on_close(window.label())).unwrap_or(false);
+        if hide {
+            match window.hide() {
+                Ok(()) => {
+                    api.prevent_close();
+                    desktop_startup::record("MAIN_WINDOW_HIDDEN_TO_TRAY", "monitoring WebView retained");
+                }
+                // Fail open: a failed tray/hide operation must not trap the app.
+                Err(error) => desktop_startup::record("BACKGROUND_HIDE_FAILED", &error.to_string()),
+            }
+        }
+    }
+}
+
+#[tauri::command]
+pub(crate) fn background_mode_get(app: AppHandle, auth: State<'_, AuthState>, session_token: String) -> Result<BackgroundModeStatus, String> {
+    require_role(&app, &auth, &session_token, Role::Viewer)?;
+    let background = app.state::<BackgroundState>();
+    let state = background.0.lock().map_err(|_| "Фоновая настройка занята")?;
+    Ok(BackgroundModeStatus { enabled: state.enabled, available: state.tray_available && !state.quitting })
+}
+
+#[tauri::command]
+pub(crate) fn background_mode_set(app: AppHandle, auth: State<'_, AuthState>, session_token: String, enabled: bool) -> Result<BackgroundModeStatus, String> {
+    require_role(&app, &auth, &session_token, Role::Viewer)?;
+    let background = app.state::<BackgroundState>();
+    let mut state = background.0.lock().map_err(|_| "Фоновая настройка занята")?;
+    state.change(enabled, || write_preferences(&open_db(&app)?, enabled))?;
+    Ok(BackgroundModeStatus { enabled: state.enabled, available: state.tray_available && !state.quitting })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn database() -> Connection {
+        let connection = Connection::open_in_memory().unwrap();
+        connection.execute_batch("CREATE TABLE kv(key TEXT PRIMARY KEY,value TEXT NOT NULL,updated_at INTEGER NOT NULL);").unwrap();
+        connection
+    }
+
+    #[test]
+    fn ordinary_close_still_exits_by_default() {
+        assert!(!Lifecycle::default().hide_on_close("main"));
+        assert!(!Lifecycle { tray_available: true, ..Lifecycle::default() }.hide_on_close("main"));
+    }
+
+    #[test]
+    fn opt_in_main_close_hides_but_other_windows_are_not_intercepted() {
+        let state = Lifecycle { enabled: true, tray_available: true, quitting: false };
+        assert!(state.hide_on_close("main"));
+        assert!(!state.hide_on_close("dialog"));
+        assert!(state.hide_on_close("main")); // repeated Open/Close retains policy
+    }
+
+    #[test]
+    fn quit_and_missing_tray_never_hide() {
+        assert!(!Lifecycle { enabled: true, tray_available: false, quitting: false }.hide_on_close("main"));
+        assert!(!Lifecycle { enabled: true, tray_available: true, quitting: true }.hide_on_close("main"));
+    }
+
+    #[test]
+    fn failed_persistence_cannot_enable_or_disable_runtime_policy() {
+        let mut state = Lifecycle { tray_available: true, ..Lifecycle::default() };
+        assert!(state.change(true, || Err("disk full".into())).is_err());
+        assert!(!state.enabled);
+        state.change(true, || Ok(())).unwrap();
+        assert!(state.change(false, || Err("disk full".into())).is_err());
+        assert!(state.enabled);
+        state.change(false, || Ok(())).unwrap();
+        assert!(!state.hide_on_close("main"));
+    }
+
+    #[test]
+    fn cannot_enable_without_a_working_tray_or_while_quitting() {
+        let mut missing = Lifecycle::default();
+        assert!(missing.change(true, || panic!("must not persist")).is_err());
+        let mut quitting = Lifecycle { tray_available: true, quitting: true, ..Lifecycle::default() };
+        assert!(quitting.change(true, || panic!("must not persist")).is_err());
+    }
+
+    #[test]
+    fn opt_in_and_disable_survive_reopening_database_settings() {
+        let connection = database();
+        assert_eq!(read_preferences(&connection).unwrap(), Preferences::default());
+        write_preferences(&connection, true).unwrap();
+        assert!(read_preferences(&connection).unwrap().enabled);
+        write_preferences(&connection, false).unwrap();
+        assert!(!read_preferences(&connection).unwrap().enabled);
+        assert_eq!(connection.query_row("SELECT COUNT(*) FROM kv", [], |row| row.get::<_, i64>(0)).unwrap(), 1);
+    }
+
+    #[test]
+    fn corrupt_or_unknown_preferences_fail_closed() {
+        let connection = database();
+        for value in ["true", "null", "{}", "{\"enabled\":1}", "{\"enabled\":true,\"unknown\":1}", "broken"] {
+            connection.execute("INSERT OR REPLACE INTO kv VALUES(?1,?2,0)", params![SETTINGS_KEY, value]).unwrap();
+            assert!(!read_preferences(&connection).unwrap().enabled, "{value}");
+        }
+        connection.execute("INSERT OR REPLACE INTO kv VALUES(?1,?2,0)", params![SETTINGS_KEY, format!("{}{{\"enabled\":true}}", " ".repeat(128))]).unwrap();
+        assert!(!read_preferences(&connection).unwrap().enabled);
+    }
+}
