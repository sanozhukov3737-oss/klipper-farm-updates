+  assert.equal(check([job(),job({status:'error'})]).confirmed,false);
+});
+test('unrelated and old rows do not suppress one exact timely proof',()=>{
+  assert.equal(check([job({filename:'other.gcode'}),job({job_id:'old',start_time:(sent-1000)/1000}),job()]).confirmed,true);
+});
+test('in-progress rows with an end timestamp are contradictory and ignored',()=>{
+  assert.equal(check([job({status:'in_progress'})]).confirmed,false);
+  assert.equal(check([job({status:'in_progress',end_time:undefined})]).confirmed,true);
+});
+
+const report={passed:true,cases:results.length,results,source:'https://moonraker.readthedocs.io/en/latest/external_api/history/',positiveEvidenceOnly:true,dispatchWindowMs:windowMs,physicalPrinterTested:false};
