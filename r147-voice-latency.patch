+      let encoded=JSON.stringify({version:1,captureTranscript:this.captureTranscript,turns:this.turns});
+      while(encoded.length>MAX_CHARACTERS&&this.turns.length){const removed=this.turns.pop()!;this.live.delete(removed.id);encoded=JSON.stringify({version:1,captureTranscript:this.captureTranscript,turns:this.turns})}
+      this.storage.setItem(this.key,encoded);this.storageError=false;this.cleanupFailed=false;
+    }catch{
+      this.storageError=true;
+      if(removePrevious){try{this.storage.removeItem(this.key);removed=true}catch{}this.cleanupFailed=!removed}
+    }
+  }
+}
diff --git a/r146-voice-quality/changes/src/lib/voiceLearnedNames.ts b/r146-voice-quality/changes/src/lib/voiceLearnedNames.ts
new file mode 100644
index 0000000..02cbca8
--- /dev/null
+++ b/r146-voice-quality/changes/src/lib/voiceLearnedNames.ts
@@ -0,0 +1,134 @@
+import { normalizeVoice } from './voiceCommands';
+
+export interface VoiceLearningStorage {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+  removeItem(key: string): void;
+}
+export type VoiceLearnedName = { query: string; scopeId: string; path: string; updatedAt: number };
+export type VoiceLearningWriteResult = { saved: boolean; reason?: 'invalid-input' | 'missing-file' | 'storage-unavailable' };
+export type VoiceLearningCandidate = { scopeId: string; entry: { path: string } };
+export type VoiceLearnedLookup<T> = { kind: 'none' | 'suggestions' | 'ambiguous'; candidates: T[]; suggestionOnly: true };
+export const VOICE_LEARNED_NAMES_MAX_ENTRIES = 200;
+// localStorage uses UTF-16: this caps a profile's serialized payload at 256 KiB.
+export const VOICE_LEARNED_NAMES_MAX_CHARACTERS = 128 * 1024;
+const PREFIX = 'klipper-voice-learned-names-v1:';
+const plain = (value: unknown, max: number): value is string => typeof value === 'string' && value.length > 0 && value.length <= max && !/[\u0000-\u001f\u007f]/u.test(value);
+const scope = (value: unknown): value is string => plain(value, 200) && value.trim().length > 0;
+const path = (value: unknown): value is string => plain(value, 4096) && value.trim().length > 0
+  && !/^(?:[\\/]|[a-z]:)/iu.test(value) && !value.split(/[\\/]/u).some(part => part === '.' || part === '..');
+function query(value: unknown) {
+  if (!plain(value, 300)) return '';
+  const normalized = normalizeVoice(value);
+  return normalized.length > 0 && normalized.length <= 300 ? normalized : '';
+}
+const identity = (row: VoiceLearnedName) => JSON.stringify([row.query, row.scopeId, row.path]);
+function identifiersCompatible(spokenQuery: string, selectedPath: string) {
+  const required: string[] = spokenQuery.normalize('NFKC').match(/\p{Decimal_Number}+/gu) ?? [];
+  if (!required.length) return true;
+  const available: string[] = selectedPath.normalize('NFKC').match(/\p{Decimal_Number}+/gu) ?? [];
+  for (const identifier of required) {
+    const index = available.indexOf(identifier);
+    if (index < 0) return false;
+    available.splice(index, 1);
+  }
+  return true;
+}
+
+/** Stores filename corrections only. Call learnConfirmed after explicit file selection,
+ * with the parsed filename query rather than a complete command. A lookup only ranks
+ * current catalog candidates; it never supplies an action or a print confirmation. */
+export class VoiceLearnedNames {
+  private readonly key?: string;
+  constructor(private readonly storage: VoiceLearningStorage | undefined, profileId: string, private readonly now = () => Date.now()) {
+    if (!plain(profileId, 128) || !profileId.trim()) return;
+    try { this.key = PREFIX + encodeURIComponent(profileId); } catch { /* Invalid profile IDs disable learning. */ }
+  }
+
+  learnConfirmed(spokenQuery: string, scopeId: string, selectedPath: string, currentCatalogPaths: readonly string[]): VoiceLearningWriteResult {
+    const normalized = query(spokenQuery);
+    if (!normalized || !scope(scopeId) || !path(selectedPath) || !Array.isArray(currentCatalogPaths)
+      || !identifiersCompatible(normalized, selectedPath)) return { saved: false, reason: 'invalid-input' };
+    if (!currentCatalogPaths.includes(selectedPath)) return { saved: false, reason: 'missing-file' };
+    const current = this.read();
+    if (!current.available) return { saved: false, reason: 'storage-unavailable' };
+    const time = this.now();
+    const row: VoiceLearnedName = { query: normalized, scopeId, path: selectedPath, updatedAt: Number.isSafeInteger(time) && time >= 0 ? time : 0 };
+    // Keep different explicit selections for the same phrase. Never silently
+    // replace one target with another and turn an ambiguous phrase into a decision.
+    const rows = [row, ...current.entries.filter(item => identity(item) !== identity(row))];
+    return this.write(rows) ? { saved: true } : { saved: false, reason: 'storage-unavailable' };
+  }
+
+  lookup<T extends VoiceLearningCandidate>(spokenQuery: string, scopeId: string, currentCandidates: readonly T[]): VoiceLearnedLookup<T> {
+    const empty: VoiceLearnedLookup<T> = { kind: 'none', candidates: [], suggestionOnly: true };
+    const normalized = query(spokenQuery);
+    if (!normalized || !scope(scopeId) || !Array.isArray(currentCandidates)) return empty;
+    const targets = new Set(this.read().entries.filter(row => row.scopeId === scopeId && row.query === normalized && identifiersCompatible(normalized, row.path)).map(row => row.path));
+    if (!targets.size) return empty;
+    // Return the caller's live catalog objects, never a stored or reconstructed entry.
+    const candidates = currentCandidates.filter(candidate => candidate?.scopeId === scopeId && candidate.entry && path(candidate.entry.path) && targets.has(candidate.entry.path));
+    return { kind: candidates.length > 1 ? 'ambiguous' : candidates.length ? 'suggestions' : 'none', candidates, suggestionOnly: true };
+  }
+
+  list(scopeId?: string): VoiceLearnedName[] {
+    if (scopeId !== undefined && !scope(scopeId)) return [];
+    return this.read().entries.filter(row => scopeId === undefined || row.scopeId === scopeId).map(row => ({ ...row }));
+  }
+
+  forget(spokenQuery: string, scopeId: string, selectedPath?: string): VoiceLearningWriteResult & { removed: number } {
+    const normalized = query(spokenQuery);
+    if (!normalized || !scope(scopeId) || selectedPath !== undefined && !path(selectedPath)) return { saved: false, removed: 0, reason: 'invalid-input' };
+    const current = this.read();
+    if (!current.available) return { saved: false, removed: 0, reason: 'storage-unavailable' };
+    const remaining = current.entries.filter(row => !(row.query === normalized && row.scopeId === scopeId && (selectedPath === undefined || row.path === selectedPath)));
+    const removed = current.entries.length - remaining.length;
+    if (!removed) return { saved: true, removed: 0 };
+    return this.write(remaining) ? { saved: true, removed } : { saved: false, removed: 0, reason: 'storage-unavailable' };
+  }
+
+  reset(scopeId?: string): VoiceLearningWriteResult & { removed: number } {
+    if (scopeId !== undefined && !scope(scopeId)) return { saved: false, removed: 0, reason: 'invalid-input' };
+    const current = this.read();
+    if (!current.available) return { saved: false, removed: 0, reason: 'storage-unavailable' };
+    const remaining = scopeId === undefined ? [] : current.entries.filter(row => row.scopeId !== scopeId);
+    const removed = current.entries.length - remaining.length;
+    return this.write(remaining) ? { saved: true, removed } : { saved: false, removed: 0, reason: 'storage-unavailable' };
+  }
+
+  private read(): { available: boolean; entries: VoiceLearnedName[] } {
+    if (!this.storage || !this.key) return { available: false, entries: [] };
+    let raw: string | null;
+    try { raw = this.storage.getItem(this.key); } catch { return { available: false, entries: [] }; }
+    if (!raw || raw.length > VOICE_LEARNED_NAMES_MAX_CHARACTERS) return { available: true, entries: [] };
+    try {
+      const parsed: unknown = JSON.parse(raw);
+      if (!parsed || typeof parsed !== 'object' || (parsed as { version?: unknown }).version !== 1 || !Array.isArray((parsed as { entries?: unknown }).entries)) return { available: true, entries: [] };
+      const entries: VoiceLearnedName[] = [], seen = new Set<string>();
+      for (const value of ((parsed as { entries: unknown[] }).entries).slice(0, VOICE_LEARNED_NAMES_MAX_ENTRIES * 2)) {
+        if (!value || typeof value !== 'object') continue;
+        const row = value as Partial<VoiceLearnedName>, normalized = query(row.query);
+        if (!normalized || !scope(row.scopeId) || !path(row.path) || !Number.isSafeInteger(row.updatedAt) || row.updatedAt! < 0) continue;
+        const valid = { query: normalized, scopeId: row.scopeId, path: row.path, updatedAt: row.updatedAt! };
+        const key = identity(valid); if (seen.has(key)) continue;
+        seen.add(key); entries.push(valid);
+        if (entries.length === VOICE_LEARNED_NAMES_MAX_ENTRIES) break;
+      }
+      return { available: true, entries };
+    } catch { return { available: true, entries: [] }; }
+  }
+
+  private write(entries: VoiceLearnedName[]) {
+    if (!this.storage || !this.key) return false;
+    const bounded = entries.slice(0, VOICE_LEARNED_NAMES_MAX_ENTRIES);
+    let encoded = JSON.stringify({ version: 1, entries: bounded });
+    while (encoded.length > VOICE_LEARNED_NAMES_MAX_CHARACTERS && bounded.length) {
+      bounded.pop(); encoded = JSON.stringify({ version: 1, entries: bounded });
+    }
+    try {
+      if (!bounded.length) this.storage.removeItem(this.key);
+      else this.storage.setItem(this.key, encoded);
+      return true;
+    } catch { return false; }
+  }
+}
diff --git a/r146-voice-quality/changes/src/lib/voiceTaskEvidence.ts b/r146-voice-quality/changes/src/lib/voiceTaskEvidence.ts
new file mode 100644
index 0000000..207ec99
--- /dev/null
+++ b/r146-voice-quality/changes/src/lib/voiceTaskEvidence.ts
@@ -0,0 +1,46 @@
+import type { HistoryJob } from '../types';
+import { matchingPrintFilename } from './printStartConfirmation';
+
+/** Moonraker's history API uses `completed`, while print_stats uses `complete`.
+ * https://moonraker.readthedocs.io/en/latest/external_api/history/ */
+export type VoiceTaskHistoryStatus = 'in_progress'|'completed'|'cancelled'|'error'|'klippy_shutdown'|'klippy_disconnect'|'interrupted';
+export type VoiceTaskHistoryEvidence = {confirmed:false}|{
+  confirmed:true;
+  jobId:string;
+  status:VoiceTaskHistoryStatus;
+  startedAt:number;
+  finished:boolean;
+};
+export const VOICE_TASK_HISTORY_START_WINDOW_MS=2*60_000;
+const statuses=new Set<VoiceTaskHistoryStatus>(['in_progress','completed','cancelled','error','klippy_shutdown','klippy_disconnect','interrupted']);
+const minimumEpoch=Date.UTC(2000,0,1),maximumEpoch=Date.UTC(2100,0,1);
+const epoch=(value:unknown):value is number=>typeof value==='number'&&Number.isFinite(value)&&value>=minimumEpoch&&value<maximumEpoch;
+const text=(value:unknown,limit:number):value is string=>typeof value==='string'&&value.length>0&&value.length<=limit&&value.trim()===value&&!/[\p{Cc}]/u.test(value);
+const relativePath=(value:unknown):value is string=>text(value,4096)&&!/^(?:[\\/]|[a-z]:)/iu.test(value)&&/\.(?:gcode|gco|g)$/iu.test(value)&&matchingPrintFilename(value,value);
+
+/** Positive evidence only: missing/old/ambiguous history never permits a retry.
+ * Call with a fresh response from the same printer and immutable dispatch time.
+ * A small dispatch window avoids attributing a later manual same-file run to an
+ * old request. This checks that a launch occurred, not that printing succeeded. */
+export function voiceTaskHistoryEvidence(jobs:readonly HistoryJob[],remotePath:string,dispatchedAt:number,now=Date.now()):VoiceTaskHistoryEvidence{
+  if(!Array.isArray(jobs)||jobs.length>250||!relativePath(remotePath)||!epoch(dispatchedAt)||!Number.isSafeInteger(dispatchedAt)||!epoch(now)||dispatchedAt>now)return{confirmed:false};
+  const matches:Array<Extract<VoiceTaskHistoryEvidence,{confirmed:true}>>=[];
+  for(const raw of jobs){
+    if(!raw||typeof raw!=='object')continue;
+    const job=raw as HistoryJob;
+    if(!text(job.job_id,160)||!relativePath(job.filename)||!matchingPrintFilename(job.filename,remotePath)||!statuses.has(job.status as VoiceTaskHistoryStatus))continue;
+    if(typeof job.start_time!=='number'||!Number.isFinite(job.start_time))continue;
+    const startedAt=job.start_time*1000;
+    if(!epoch(startedAt)||startedAt<dispatchedAt||startedAt>now||startedAt-dispatchedAt>VOICE_TASK_HISTORY_START_WINDOW_MS)continue;
+    if(job.end_time!==undefined&&job.end_time!==null){
+      if(typeof job.end_time!=='number'||!Number.isFinite(job.end_time))continue;
+      const endedAt=job.end_time*1000;
+      if(!epoch(endedAt)||endedAt<startedAt||endedAt>now)continue;
+      if(job.status==='in_progress')continue;
+    }
+    matches.push({confirmed:true,jobId:job.job_id,status:job.status as VoiceTaskHistoryStatus,startedAt,finished:job.status!=='in_progress'});
+  }
+  // More than one row is ambiguous even when IDs repeat: do not guess which
+  // history record belongs to this request or merge conflicting snapshots.
+  return matches.length===1?matches[0]:{confirmed:false};
+}
diff --git a/r146-voice-quality/changes/src/lib/voiceTaskQueue.ts b/r146-voice-quality/changes/src/lib/voiceTaskQueue.ts
new file mode 100644
index 0000000..0b3a76e
--- /dev/null
+++ b/r146-voice-quality/changes/src/lib/voiceTaskQueue.ts
@@ -0,0 +1,188 @@
+import type { PrinterModel } from '../types';
+import { localLibraryScopeId } from './localLibraryScope';
+
+export type VoiceTaskStatus = 'draft'|'prepared'|'sending'|'awaiting-confirmation'|'started'|'failed'|'cancelled'|'needs-check';
+export interface VoiceTaskStorage {getItem(key:string):string|null;setItem(key:string,value:string):void;removeItem(key:string):void}
+export type VoiceTaskDraft = {query:string;scopeId:string;path:string;printerId:string;printerName:string;sha256?:string;target?:string};
+export type VoiceTask = VoiceTaskDraft & {id:string;batchId:string;copy:number;status:VoiceTaskStatus;createdAt:number;updatedAt:number;remotePath?:string;dispatchedAt?:number;error?:string};
+export type VoiceTaskUpdate = {sha256?:string;target?:string;remotePath?:string;error?:string;confirmed?:boolean;confirmedNotStarted?:boolean};
+export type VoiceTaskResult = {ok:boolean;task?:VoiceTask;error?:string};
+export const VOICE_TASK_QUEUE_LIMIT=200;
+export const VOICE_TASK_QUEUE_MAX_CHARACTERS=256*1024;
+const PREFIX='klipper-voice-task-queue-v1:';
+const statuses=new Set<VoiceTaskStatus>(['draft','prepared','sending','awaiting-confirmation','started','failed','cancelled','needs-check']);
+const busyStatuses=new Set<VoiceTaskStatus>(['sending','awaiting-confirmation']);
+const blockedStatuses=new Set<VoiceTaskStatus>(['sending','awaiting-confirmation','needs-check']);
+const plain=(value:unknown,max:number):value is string=>typeof value==='string'&&value.length>0&&value.length<=max&&!/[\u0000-\u001f\u007f]/u.test(value)&&!!value.trim();
+const identifier=(value:unknown):value is string=>typeof value==='string'&&/^[A-Za-z0-9_.:-]{1,128}$/.test(value);
+const path=(value:unknown):value is string=>plain(value,4096)&&!/^(?:[\\/]|[a-z]:)/iu.test(value)&&!value.split(/[\\/]/u).some(part=>part==='.'||part==='..')&&/\.(?:gcode|gco|g)$/iu.test(value);
+const sha=(value:unknown):value is string=>typeof value==='string'&&/^[a-f0-9]{64}$/u.test(value);
+const timestamp=(value:unknown):value is number=>Number.isSafeInteger(value)&&Number(value)>=0;
+const clone=(task:VoiceTask):VoiceTask=>({...task});
+const validDraft=(value:unknown):value is VoiceTaskDraft=>{
+  if(!value||typeof value!=='object')return false;const item=value as VoiceTaskDraft;
+  return plain(item.query,300)&&plain(item.scopeId,200)&&path(item.path)&&plain(item.printerId,200)&&plain(item.printerName,200)
+    &&(item.sha256===undefined||sha(item.sha256))&&(item.target===undefined||plain(item.target,8192));
+};
+const signature=(items:readonly VoiceTaskDraft[])=>JSON.stringify(items.map(item=>[item.query,item.scopeId,item.path,item.printerId,item.printerName,item.sha256??null,item.target??null]));
+type Receipt={id:string;signature:string;itemIds:string[]};
+type State={version:1;revision:number;tasks:VoiceTask[];receipts:Receipt[]};
+type Read={state:State;available:boolean;error?:string};
+const empty=():State=>({version:1,revision:0,tasks:[],receipts:[]});
+
+/** Local review plan, never a Moonraker auto-start queue. There are deliberately
+ * no upload/start callbacks. Every resumed task goes through the assistant's
+ * current catalog, model, hash, readiness and separate confirmation checks. */
+export class VoiceTaskQueue {
+  private readonly key?:string;
+  private listeners=new Set<()=>void>();
+  private lastError?:string;
+  constructor(private readonly storage:VoiceTaskStorage|undefined,profileId:string,private readonly now=()=>Date.now()){
+    if(plain(profileId,128))try{this.key=PREFIX+encodeURIComponent(profileId)}catch{}
+    this.recoverInterrupted();
+  }
+  subscribe(listener:()=>void){this.listeners.add(listener);return()=>{this.listeners.delete(listener)}}
+  availability(){const current=this.read();return{available:current.available,error:this.lastError??current.error}}
+  list(){return this.read().state.tasks.map(clone)}
+  get(id:string){const item=this.read().state.tasks.find(task=>task.id===id);return item?clone(item):undefined}
+  addPlan(drafts:readonly VoiceTaskDraft[],requestId:string):{ok:boolean;tasks:VoiceTask[];created:boolean;error?:string}{
+    const current=this.read();
+    if(!current.available)return{ok:false,tasks:[],created:false,error:current.error};
+    if(!identifier(requestId)||!Array.isArray(drafts)||!drafts.length||drafts.length>99||!drafts.every(validDraft))return{ok:false,tasks:[],created:false,error:'Некорректный план печати'};
+    const stamp=signature(drafts),existing=current.state.receipts.find(item=>item.id===requestId);
+    if(existing){
+      if(existing.signature!==stamp)return{ok:false,tasks:[],created:false,error:'Этот запрос уже сохранён с другим планом'};
+      return{ok:true,tasks:current.state.tasks.filter(item=>item.batchId===requestId).map(clone),created:false};
+    }
+    if(current.state.tasks.length+drafts.length>VOICE_TASK_QUEUE_LIMIT||current.state.receipts.length>=VOICE_TASK_QUEUE_LIMIT)return{ok:false,tasks:[],created:false,error:'План заполнен. Удалите завершённые задания или очистите проверенный план'};
+    const time=this.time(),tasks=drafts.map((draft,index):VoiceTask=>({...draft,id:`${requestId}:${index+1}`,batchId:requestId,copy:index+1,status:'draft',createdAt:time,updatedAt:time}));
+    current.state.tasks.push(...tasks);current.state.receipts.push({id:requestId,signature:stamp,itemIds:tasks.map(item=>item.id)});
+    if(!this.write(current.state))return{ok:false,tasks:[],created:false,error:this.lastError};
+    return{ok:true,tasks:tasks.map(clone),created:true};
+  }
+  setStatus(id:string,status:VoiceTaskStatus,details:VoiceTaskUpdate={}):VoiceTaskResult{
+    const current=this.read();if(!current.available)return{ok:false,error:current.error};
+    const task=current.state.tasks.find(item=>item.id===id);if(!task)return{ok:false,error:'Задание удалено или не найдено'};
+    if(!statuses.has(status))return{ok:false,error:'Неизвестный этап задания'};
+    const error=(message:string):VoiceTaskResult=>({ok:false,task:clone(task),error:message});
+    if(task.status==='started'||task.status==='cancelled')return error('Задание уже завершено. Повторный запуск не разрешён');
+    if(task.status==='needs-check')return error('Сначала проверьте ранее отправленный запуск');
+    if(details.error!==undefined&&!plain(details.error,600))return error('Некорректное описание ошибки');
+    if(details.remotePath!==undefined&&!path(details.remotePath))return error('Некорректное имя отправленного файла');
+    if(status==='prepared'){
+      if(!['draft','prepared','failed'].includes(task.status)||!sha(details.sha256)||!plain(details.target,8192))return error('Нужна новая проверка файла и принтера');
+      if(task.sha256&&task.sha256!==details.sha256)return error('Файл изменился после составления плана. Выберите его заново');
+      if(task.target&&task.target!==details.target)return error('Принтер или его настройки изменились. Составьте план заново');
+      task.sha256=details.sha256;task.target=details.target;delete task.remotePath;delete task.dispatchedAt;
+    }else if(status==='sending'){
+      if(task.status!=='prepared'||!task.sha256||!task.target)return error('Задание не подготовлено или уже отправляется');
+      if(current.state.tasks.some(item=>item.id!==id&&item.printerId===task.printerId&&blockedStatuses.has(item.status)))return error('На этом принтере есть непроверенная отправка. Повторный запуск запрещён');
+    }else if(status==='awaiting-confirmation'){
+      if(task.status!=='sending'||!details.remotePath)return error('Передача файла ещё не подтверждена');
+      // Durable uncertain boundary: the caller persists this before deps.start.
+      // History recovery must match this exact path and dispatch time.
+      task.remotePath=details.remotePath;task.dispatchedAt=this.time();
+    }else if(status==='started'){
+      if(task.status!=='awaiting-confirmation'||details.confirmed!==true||!task.remotePath)return error('Принтер ещё не подтвердил запуск');
+      if(details.remotePath&&details.remotePath!==task.remotePath)return error('Подтверждён другой файл');
+    }else if(status==='needs-check'){
+      if(task.status!=='awaiting-confirmation')return error('Команда запуска не отправлялась');
+    }else if(status==='failed'||status==='cancelled'){
+      if(task.status==='awaiting-confirmation'&&details.confirmedNotStarted!==true)return error('Результат запуска неизвестен. Нужна проверка состояния');
+    }else if(status==='draft'){
+      if(!['draft','prepared','failed'].includes(task.status))return error('Нельзя сбросить выполняемую отправку');
+    }
+    task.status=status;task.updatedAt=this.time();
+    if(details.error)task.error=details.error;else delete task.error;
+    if(!this.write(current.state))return{ok:false,error:this.lastError};
+    return{ok:true,task:clone(task)};
+  }
+  /** Called only after an actual read-only printer check. A negative/empty
+   * response alone never proves that a late print-start cannot arrive. */
+  reconcile(id:string,result:{confirmed:boolean;remotePath?:string;target?:string;confirmedNotStarted?:boolean}):VoiceTaskResult{
+    const current=this.read();if(!current.available)return{ok:false,error:current.error};
+    const task=current.state.tasks.find(item=>item.id===id);if(!task)return{ok:false,error:'Задание не найдено'};
+    if(task.status!=='needs-check'&&task.status!=='awaiting-confirmation')return{ok:false,task:clone(task),error:'Нет непроверенного запуска'};
+    if(!task.target||result.target!==task.target)return{ok:false,task:clone(task),error:'Соединение или настройки принтера изменились. Проверьте его карточку'};
+    if(result.remotePath!==undefined&&(!path(result.remotePath)||task.remotePath&&result.remotePath!==task.remotePath))return{ok:false,task:clone(task),error:'Подтверждён другой файл'};
+    if(result.confirmed){
+      if(!task.remotePath||result.remotePath!==task.remotePath)return{ok:false,task:clone(task),error:'Нужно подтверждение точного отправленного файла'};
+      task.status='started';delete task.error;
+    }else if(result.confirmedNotStarted===true){task.status='failed';task.error='Проверка подтвердила, что запуск не состоялся. Нужна новая подготовка'}
+    else return{ok:true,task:clone(task)};
+    task.updatedAt=this.time();if(!this.write(current.state))return{ok:false,error:this.lastError};return{ok:true,task:clone(task)};
+  }
+  remove(id:string):VoiceTaskResult{
