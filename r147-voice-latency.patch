+test('print_stats and arbitrary vendor statuses are not history evidence',()=>{
+  for(const status of ['complete','printing','paused','ready','unknown','failed','COMPLETED',''])assert.equal(check([job({status})]).confirmed,false,status);
+});
+test('old same-file history cannot resolve a new copy',()=>{
+  assert.equal(check([job({start_time:(sent-1)/1000})]).confirmed,false);
