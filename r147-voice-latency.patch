+import { useEffect, useState } from 'react';
+import { Monitor } from 'lucide-react';
+import { backgroundModeGet, backgroundModeSet, type BackgroundModeStatus } from '../lib/backgroundMode';
+
+export function BackgroundModeSettings() {
+  const [settings, setSettings] = useState<BackgroundModeStatus>();
+  const [busy, setBusy] = useState(false), [error, setError] = useState('');
+  useEffect(() => {
+    let current = true;
+    void backgroundModeGet().then(value => { if (current) setSettings(value); })
+      .catch(() => { if (current) setError('Не удалось прочитать фоновую настройку. Откройте настройки ещё раз.'); });
+    return () => { current = false; };
+  }, []);
+  const save = async (enabled: boolean) => {
+    setBusy(true); setError('');
+    try { setSettings(await backgroundModeSet(enabled)); }
+    catch { setError('Не удалось сохранить фоновый режим. Настройка не изменена.'); }
+    finally { setBusy(false); }
+  };
+  return <section className="runtimeCard" aria-label="Фоновый режим"><Monitor/><div style={{ gridColumn: '2 / -1', justifySelf: 'stretch' }}>
+    <h3>Работа в трее</h3>
+    <p>При закрытии окно скроется, а контроль принтеров и настроенные уведомления продолжат работать во время активного сеанса. Нажмите значок Klipper Farm в трее, чтобы открыть окно.</p>
+    <label className="switch"><input type="checkbox" checked={settings?.enabled ?? false} disabled={busy || !settings || (!settings.available && !settings.enabled)} onChange={event => void save(event.target.checked)}/>Закрывать окно в трей</label>
+    <p>«Выйти из Klipper Farm» в меню значка полностью завершает приложение и останавливает уведомления. Во время сна или выключения компьютера уведомления не работают. Автозапуск настраивается отдельно.</p>
+    {settings && !settings.available && <p role="status">Значок трея недоступен: закрытие окна завершит приложение.</p>}
+    {error && <p role="alert">{error}</p>}
+  </div></section>;
+}
