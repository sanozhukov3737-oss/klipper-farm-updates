+import { useEffect, useId, useState } from 'react';
+import { Volume2 } from 'lucide-react';
+import { PRINT_NEAR_END_LEAD_MINUTES } from '../lib/printNearEnd';
+import { PRINT_NEAR_END_CHANGED, printNearEndPreferences, savePrintNearEndPreferences } from '../lib/printNearEndPreferences';
+export function PrintNearEndSettings() {
+  const id = useId(), [settings, setSettings] = useState(printNearEndPreferences), [error, setError] = useState('');
+  useEffect(() => {
+    const update = () => setSettings(printNearEndPreferences());
+    window.addEventListener(PRINT_NEAR_END_CHANGED, update); window.addEventListener('storage', update);
+    return () => { window.removeEventListener(PRINT_NEAR_END_CHANGED, update); window.removeEventListener('storage', update); };
+  }, []);
+  const save = (value: typeof settings) => {
+    try { setSettings(savePrintNearEndPreferences(value)); setError(''); }
+    catch { setError('Не удалось сохранить настройку. Повторите изменение.'); }
+  };
+  return <section className="runtimeCard" aria-label="Предупреждение перед окончанием печати"><Volume2/><div style={{ gridColumn: '2 / -1', justifySelf: 'stretch' }}>
+    <h3>Печать скоро завершится</h3><p>Ксения один раз назовёт принтер и примерное оставшееся время. Работает, пока приложение открыто, даже при закрытой помощнице.</p>
+    <div style={{ display: 'flex', alignItems: 'center', flexWrap: 'wrap', gap: 12, marginTop: 12 }}><label className="switch"><input type="checkbox" checked={settings.enabled} onChange={event => save({ ...settings, enabled: event.target.checked })}/>Голос и уведомление</label>
+    <label htmlFor={id}>Примерно за <select id={id} disabled={!settings.enabled} value={settings.leadMinutes} onChange={event => save({ ...settings, leadMinutes: Number(event.target.value) })}>
+      {PRINT_NEAR_END_LEAD_MINUTES.map(minutes => <option key={minutes} value={minutes}>{minutes} мин</option>)}
+    </select></label></div><p>Прогноз уточняется по живым данным принтера. Во время разговора предупреждение подождёт; при паузе или потере связи озвучка откладывается.</p>
+    {error && <p role="alert">{error}</p>}
+  </div></section>;
+}
