+import { useId } from 'react';
+import { ClipboardList, RefreshCw, SearchCheck, Trash2 } from 'lucide-react';
+import { voiceTaskProgress, type VoiceTask } from '../lib/voiceTaskQueue';
+import './VoiceTaskQueuePanel.css';
+
+export type VoiceTaskQueuePanelProps = {
+  tasks: readonly VoiceTask[];
+  busy?: boolean;
+  canOperate?: boolean;
+  onPrepare: (id: string) => void;
+  onCheck?: (id: string) => void;
+  onRemove: (id: string) => void;
+  onReset: () => void;
+};
+
+/** A review list only. Preparing a row delegates fresh validation to the
+ * assistant; this component never uploads files or sends printer commands. */
+export function VoiceTaskQueuePanel({ tasks, busy = false, canOperate = true, onPrepare, onCheck, onRemove, onReset }: VoiceTaskQueuePanelProps) {
+  const id = useId();
+  const blockedReset = busy || tasks.some(task => {
+    const progress = voiceTaskProgress(task);
+    return progress.busy || progress.needsCheck;
+  });
+  return <section className="kfVoiceTaskQueue" aria-labelledby={id}>
+    <div className="kfVoiceTaskQueueHeading">
+      <h3 id={id}><ClipboardList aria-hidden="true"/>План заданий <span>({tasks.length})</span></h3>
+      <button type="button" disabled={!tasks.length || blockedReset} onClick={onReset} aria-label="Очистить план голосовых заданий"><Trash2 aria-hidden="true"/>Очистить</button>
+    </div>
+    <p className="kfVoiceTaskQueueHint">План сохраняется для текущего пользователя. Каждое задание — отдельный запуск готового G-code: проверьте число деталей в самом файле. Перед каждым запуском нужны новая проверка и ваше подтверждение.</p>
+    {!tasks.length ? <p className="kfVoiceTaskQueueEmpty">Заданий пока нет. Назовите файл и нужное число запусков.</p> : <ul className="kfVoiceTaskQueueItems">
+      {tasks.map(task => {
+        const progress = voiceTaskProgress(task);
+        return <li key={task.id} className={`kfVoiceTaskQueueItem is-${task.status}`}>
+          <div className="kfVoiceTaskQueueTarget"><b>{task.path}</b><span>{task.printerName} · запуск {task.copy}</span></div>
+          <div className="kfVoiceTaskQueueProgress" role="status"><strong>{progress.busy && <RefreshCw className="spin" aria-hidden="true"/>}{progress.label}</strong><span>{progress.detail}</span></div>
+          <div className="kfVoiceTaskQueueActions">
+            {progress.canPrepare && <button type="button" disabled={busy||!canOperate} onClick={() => onPrepare(task.id)} aria-label={`Проверить и подготовить ${task.path} на ${task.printerName}`}><SearchCheck aria-hidden="true"/>Проверить и подготовить</button>}
+            {progress.needsCheck && onCheck && <button type="button" disabled={busy} onClick={() => onCheck(task.id)} aria-label={`Проверить запуск ${task.path} на ${task.printerName}`}><SearchCheck aria-hidden="true"/>Проверить запуск</button>}
+            {progress.canRemove && <button type="button" disabled={busy} onClick={() => onRemove(task.id)} aria-label={`Удалить из плана ${task.path} на ${task.printerName}`}><Trash2 aria-hidden="true"/>Убрать</button>}
+          </div>
+        </li>;
+      })}
+    </ul>}
+  </section>;
+}
