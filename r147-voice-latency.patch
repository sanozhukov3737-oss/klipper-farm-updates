+  try { const error = await rejected(client.start('part.gcode')); assert.equal(printStartDefinitelyNotSent(error), true); assert.equal(error.message, original.message); assert.equal(error.cause, original); assert.equal(uncertainPrintStart(error), false); assert.equal(starts, 0); }
