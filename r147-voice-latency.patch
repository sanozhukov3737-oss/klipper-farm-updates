+  for(const status of ['cancelled','error','klippy_shutdown','klippy_disconnect','interrupted']){
+    const result=check([job({status,end_time:null})]);assert.equal(result.confirmed,true,status);assert.equal(result.finished,true,status);assert.equal(result.status,status);
+  }
