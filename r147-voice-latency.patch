diff --git a/r146-voice-quality/changes/src/components/VoiceCatalogMetadataEditor.tsx b/r146-voice-quality/changes/src/components/VoiceCatalogMetadataEditor.tsx
new file mode 100644
index 0000000..bc3e177
--- /dev/null
+++ b/r146-voice-quality/changes/src/components/VoiceCatalogMetadataEditor.tsx
@@ -0,0 +1,45 @@
+import { useEffect, useMemo, useState } from 'react';
+import type { LocalLibraryEntry } from '../lib/native';
+import { VoiceCatalog, VOICE_CATALOG_LIMITS, voiceCatalogEntryIdentity } from '../lib/voiceCatalog';
+import type { VoiceLearningStorage } from '../lib/voiceLearnedNames';
+import './VoiceCatalogMetadataEditor.css';
+
+const localStorageIfAvailable = (): VoiceLearningStorage | undefined => { try { return localStorage; } catch { return undefined; } };
+export function VoiceCatalogMetadataEditor({ userId, scopeId, entry, catalog, onChanged }: {
+  userId: string; scopeId: string; entry: LocalLibraryEntry; catalog?: VoiceCatalog; onChanged?: () => void;
+}) {
+  const ownCatalog = useMemo(() => new VoiceCatalog(localStorageIfAvailable(), userId), [userId]);
+  const current = catalog?.profileId === userId ? catalog : ownCatalog;
+  const identity = voiceCatalogEntryIdentity(entry), [description, setDescription] = useState(''), [tags, setTags] = useState(''), [message, setMessage] = useState('');
+  useEffect(() => {
+    const value = current.metadata(scopeId, entry);
+    setDescription(value?.description ?? ''); setTags(value?.tags.join(', ') ?? ''); setMessage('');
+  }, [current, scopeId, entry.path, identity]);
+  const save = (clear = false) => {
+    const result = current.saveMetadata(scopeId, entry, { description: clear ? '' : description, tags: clear ? [] : tags.split(/[,;\n]/u).map(value => value.trim()).filter(Boolean) });
+    if (!result.saved) {
+      setMessage(result.reason === 'identity-unavailable' ? 'Обновите список файлов: версия этого файла пока неизвестна.'
+        : result.reason === 'invalid-input' ? `Описание — до ${VOICE_CATALOG_LIMITS.description} символов; до ${VOICE_CATALOG_LIMITS.tags} меток по ${VOICE_CATALOG_LIMITS.tag} символов.`
+          : 'Не удалось сохранить описание. Проверьте доступность локального хранилища.');
+      return;
+    }
+    const value = current.metadata(scopeId, entry); setDescription(value?.description ?? ''); setTags(value?.tags.join(', ') ?? '');
+    setMessage(clear ? 'Описание и метки очищены.' : result.pruned ? 'Сохранено. Достигнут лимит каталога: самые старые записи удалены.' : 'Сохранено.'); onChanged?.();
+  };
+  return <details className="voiceCatalogMetadata" onClick={event => event.stopPropagation()}>
+    <summary>Описание и метки файла</summary>
+    <div className="voiceCatalogMetadataBody">
+      <p>Своими словами опишите назначение детали. Помощница сможет найти её по описанию и меткам.</p>
+      <small title={entry.path}>{entry.path}</small>
+      <label>Описание<textarea value={description} maxLength={VOICE_CATALOG_LIMITS.description} rows={3}
+        placeholder="Например: маленькая подставка для телефона на стол" onChange={event => { setDescription(event.target.value); setMessage(''); }} /></label>
+      <label>Метки через запятую<input value={tags} maxLength={700} placeholder="телефон, подставка, рабочий стол"
+        onChange={event => { setTags(event.target.value); setMessage(''); }} /></label>
+      <span>Описание сохраняется для вашей учётной записи. Размеры указывайте только известные вам.</span>
+      {!identity && <span role="status">Для сохранения обновите список файлов.</span>}
+      <div className="voiceCatalogMetadataActions"><button type="button" disabled={!identity} onClick={() => save()}>Сохранить описание</button>
+        <button type="button" disabled={!identity} onClick={() => save(true)}>Очистить описание</button></div>
+      {message && <p role="status">{message}</p>}
+    </div>
+  </details>;
+}
