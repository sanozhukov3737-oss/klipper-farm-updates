+const results=[];
+const test=(name,fn)=>{fn();results.push({name,passed:true});console.log('PASS',name)};
+const sent=Date.UTC(2026,9,30,10),now=sent+10*60_000,path='детали/держатель.gcode';
+const job=(overrides={})=>({job_id:'000001',filename:path,status:'completed',start_time:(sent+500)/1000,end_time:(sent+9000)/1000,...overrides});
