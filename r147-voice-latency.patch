diff --git a/r146-voice-quality/changes/scripts/whisper-context.h b/r146-voice-quality/changes/scripts/whisper-context.h
new file mode 100644
index 0000000..68e8567
--- /dev/null
+++ b/r146-voice-quality/changes/scripts/whisper-context.h
@@ -0,0 +1,86 @@
+// Request-local, bounded speech vocabulary. This header has no Windows/DLL
+// dependencies so the exact worker frame parser can also be tested locally.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace farm_speech {
+constexpr size_t max_wave_bytes = 640044;
+constexpr size_t min_wave_bytes = 3244;
+constexpr size_t max_context_bytes = 1024;
+constexpr size_t max_context_characters = 512;
+constexpr size_t max_request_bytes = max_wave_bytes + 12 + max_context_bytes;
+constexpr char context_magic[] = "KFWHSR01";
+
+inline uint32_t little_u32(const unsigned char * data) {
+    return static_cast<uint32_t>(data[0]) | (static_cast<uint32_t>(data[1]) << 8) |
+        (static_cast<uint32_t>(data[2]) << 16) | (static_cast<uint32_t>(data[3]) << 24);
+}
+inline uint16_t little_u16(const unsigned char * data) {
+    return static_cast<uint16_t>(data[0]) | static_cast<uint16_t>(data[1] << 8);
+}
+inline void validate_context(const std::string & text) {
+    if (text.size() > max_context_bytes) throw std::runtime_error("Speech context exceeded its limit");
+    size_t characters = 0;
+    for (size_t offset = 0; offset < text.size();) {
+        const auto first = static_cast<unsigned char>(text[offset++]);
+        uint32_t code = first;
+        unsigned continuation = 0;
+        if (first >= 0xc2 && first <= 0xdf) { code = first & 0x1fu; continuation = 1; }
+        else if (first >= 0xe0 && first <= 0xef) { code = first & 0x0fu; continuation = 2; }
+        else if (first >= 0xf0 && first <= 0xf4) { code = first & 0x07u; continuation = 3; }
+        else if (first >= 0x80) throw std::runtime_error("Invalid speech context UTF-8");
+        if (offset + continuation > text.size()) throw std::runtime_error("Incomplete speech context UTF-8");
+        for (unsigned index = 0; index < continuation; ++index) {
+            const auto next = static_cast<unsigned char>(text[offset++]);
+            if ((next & 0xc0u) != 0x80u) throw std::runtime_error("Invalid speech context UTF-8");
+            code = (code << 6) | (next & 0x3fu);
+        }
+        if ((continuation == 1 && code < 0x80) || (continuation == 2 && code < 0x800) ||
+            (continuation == 3 && code < 0x10000) || code > 0x10ffff || (code >= 0xd800 && code <= 0xdfff)) {
+            throw std::runtime_error("Invalid speech context UTF-8");
+        }
+        if (code < 0xa0) {
+            const bool ascii_name = (code >= 'a' && code <= 'z') || (code >= 'A' && code <= 'Z') ||
+                (code >= '0' && code <= '9') || code == ' ' || code == '.' || code == '_' ||
+                code == '(' || code == ')' || code == '-';
+            if (!ascii_name) throw std::runtime_error("Invalid speech context character");
+        } else if ((code >= 0x200b && code <= 0x200f) || (code >= 0x2028 && code <= 0x202e) ||
+                   (code >= 0x2060 && code <= 0x206f) || code == 0xfeff) {
+            throw std::runtime_error("Invalid speech context character");
+        }
+        if (++characters > max_context_characters) throw std::runtime_error("Speech context exceeded its limit");
+    }
+}
+struct RecognitionFrame { size_t wave_offset = 0; std::string context; };
+inline RecognitionFrame parse_recognition_frame(const std::vector<unsigned char> & payload) {
+    if (payload.size() < min_wave_bytes || payload.size() > max_request_bytes) {
+        throw std::runtime_error("Invalid speech frame size");
+    }
+    RecognitionFrame result;
+    if (std::memcmp(payload.data(), context_magic, 8) == 0) {
+        const auto context_bytes = little_u32(payload.data() + 8);
+        if (context_bytes > max_context_bytes || 12u + context_bytes > payload.size() - min_wave_bytes) {
+            throw std::runtime_error("Invalid speech context frame size");
+        }
+        result.context.assign(reinterpret_cast<const char *>(payload.data() + 12), context_bytes);
+        validate_context(result.context);
+        result.wave_offset = 12 + context_bytes;
+    }
+    const auto size = payload.size() - result.wave_offset;
+    const auto wave = payload.data() + result.wave_offset;
+    if (size < min_wave_bytes || size > max_wave_bytes || (size - 44) % 2 ||
+        std::memcmp(wave, "RIFF", 4) || std::memcmp(wave + 8, "WAVEfmt ", 8) ||
+        std::memcmp(wave + 36, "data", 4) || little_u32(wave + 4) != size - 8 ||
+        little_u32(wave + 16) != 16 || little_u16(wave + 20) != 1 || little_u16(wave + 22) != 1 ||
+        little_u32(wave + 24) != 16000 || little_u32(wave + 28) != 32000 ||
+        little_u16(wave + 32) != 2 || little_u16(wave + 34) != 16 || little_u32(wave + 40) != size - 44) {
+        throw std::runtime_error("Invalid speech WAV frame");
+    }
+    return result;
+}
+} // namespace farm_speech
