+import type { PrinterModel } from '../types';
+import { printerFinish } from './printerFinish';
+import { jobFreshness, TELEMETRY_LIVE_MS } from './printerTelemetry';
+
+export type PrintNearEndPreferences = { enabled: boolean; leadMinutes: number };
+export const PRINT_NEAR_END_DEFAULTS: PrintNearEndPreferences = { enabled: true, leadMinutes: 10 };
+export const PRINT_NEAR_END_LEAD_MINUTES = [5, 10, 15, 30] as const;
+export function normalizePrintNearEndPreferences(value: unknown): PrintNearEndPreferences {
+  const row = value && typeof value === 'object' ? value as Partial<PrintNearEndPreferences> : {};
+  return { enabled: typeof row.enabled === 'boolean' ? row.enabled : true,
+    leadMinutes: PRINT_NEAR_END_LEAD_MINUTES.some(minutes => minutes === row.leadMinutes) ? row.leadMinutes! : 10 };
+}
+type Printer = Pick<PrinterModel, 'id' | 'name' | 'status'>;
+type Job = { printerId: string; key: string; filename: string; duration: number; progress: number; active: boolean; notified: boolean; spoken: boolean };
+type ObservedJob = Job & { sampleAt?: number; signature?: string; eligibleSince?: number; eligibleUntil?: number };
+export type PrintNearEndNotice = { printerId: string; jobKey: string; printerName: string; remainingSeconds: number; notified: boolean };
+export type PrintNearEndSnapshot = { version: 1; jobs: Job[] };
+
+/** Notification identity survives pauses/reconnects; it never authorizes printer operations. */
+export class PrintNearEndTracker {
+  private jobs = new Map<string, ObservedJob>();
+  constructor(snapshot?: unknown, private makeKey = () => crypto.randomUUID()) {
+    if (!snapshot || typeof snapshot !== 'object' || (snapshot as PrintNearEndSnapshot).version !== 1 || !Array.isArray((snapshot as PrintNearEndSnapshot).jobs)) return;
+    for (const row of (snapshot as PrintNearEndSnapshot).jobs.slice(0, 200)) {
+      if (!row || typeof row.printerId !== 'string' || row.printerId.length > 200 || typeof row.key !== 'string' || row.key.length > 200
+        || typeof row.filename !== 'string' || !row.filename || row.filename.length > 4096 || !Number.isFinite(row.duration) || row.duration < 0
+        || !Number.isFinite(row.progress) || row.progress < 0 || row.progress > 1 || typeof row.active !== 'boolean'
+        || typeof row.notified !== 'boolean' || typeof row.spoken !== 'boolean') continue;
+      this.jobs.set(row.printerId, { printerId: row.printerId, key: row.key, filename: row.filename, duration: row.duration,
+        progress: row.progress, active: row.active, notified: row.notified, spoken: row.spoken });
+    }
+  }
+  snapshot(): PrintNearEndSnapshot {
+    return { version: 1, jobs: [...this.jobs.values()].map(({ printerId, key, filename, duration, progress, active, notified, spoken }) =>
+      ({ printerId, key, filename, duration, progress, active, notified, spoken })) };
+  }
+  observe(printers: Printer[], preferences: PrintNearEndPreferences, now = Date.now()): PrintNearEndNotice[] {
+    const ids = new Set(printers.map(printer => printer.id));
+    for (const id of this.jobs.keys()) if (!ids.has(id)) this.jobs.delete(id);
+    const notices: PrintNearEndNotice[] = [];
+    for (const printer of printers) {
+      const status = printer.status, filename = status.filename?.trim();
+      let job = this.jobs.get(printer.id);
+      const live = jobFreshness(status, now) === 'live' && status.connectionState === 'online' && !status.remoteControlSuspended;
+      const terminal = status.state === 'error' || status.state === 'ready' && (status.progress >= 1
+        || ['complete', 'completed', 'cancelled', 'canceled', 'standby', 'error', 'failed', 'interrupted'].includes(status.printStatsState ?? ''));
+      if (live && terminal) {
+        if (job) { job.active = false; this.suspend(job); }
+        continue;
+      }
+      if (!live || (status.state !== 'printing' && status.state !== 'paused') || !filename || !Number.isFinite(status.printDuration) || !Number.isFinite(status.progress)) {
+        if (job) this.suspend(job);
+        continue;
+      }
+      // No job ID is exposed by these firmware snapshots. A different filename,
+      // observed terminal boundary, or a substantial elapsed/progress reset is a new job.
+      const restarted = job && status.printDuration + 30 < job.duration && status.progress + .05 < job.progress;
+      if (!job || !job.active || job.filename !== filename || restarted) {
+        job = { printerId: printer.id, key: this.makeKey(), filename, duration: status.printDuration, progress: status.progress,
+          active: true, notified: false, spoken: false };
+        this.jobs.set(printer.id, job);
+      }
+      job.duration = status.printDuration; job.progress = status.progress;
+      const forecast = printerFinish(status, now), remaining = forecast.remainingSeconds;
+      if (!preferences.enabled || status.state !== 'printing' || job.spoken || status.printDuration < 120 || status.progress < .5
+        || remaining === undefined || remaining <= 0 || remaining > preferences.leadMinutes * 60) {
+        this.suspend(job); continue;
+      }
+      const signature = `${status.progress}:${status.printDuration}`;
+      if (job.eligibleSince === undefined) {
+        job.eligibleSince = now; job.sampleAt = status.jobUpdatedAt; job.signature = signature;
+      } else if (signature !== job.signature && status.jobUpdatedAt! > (job.sampleAt ?? 0)) {
+        if (now - job.eligibleSince >= 5_000) job.eligibleUntil = status.jobUpdatedAt! + TELEMETRY_LIVE_MS;
+        job.signature = signature; job.sampleAt = status.jobUpdatedAt;
+      }
+      if (job.eligibleUntil !== undefined && job.eligibleUntil >= now) notices.push({ printerId: printer.id, jobKey: job.key,
+        printerName: printer.name, remainingSeconds: remaining, notified: job.notified });
+    }
+    return notices;
